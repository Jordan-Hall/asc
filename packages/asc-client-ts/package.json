{
  "name": "@asc/asc-client",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./relay": "./src/transport/relay.ts",
    "./allowlist.json": "./src/transport/allowlist.json",
    "./forgejo": "./src/forgejo/index.ts",
    "./agents": "./src/gen/asc/v1/agents_pb.ts",
    "./aiproviders": "./src/gen/asc/v1/aiproviders_pb.ts",
    "./audit": "./src/gen/asc/v1/audit_pb.ts",
    "./bridge": "./src/gen/asc/v1/bridge_pb.ts",
    "./changes": "./src/gen/asc/v1/changes_pb.ts",
    "./ci": "./src/gen/asc/v1/ci_pb.ts",
    "./cli": "./src/gen/asc/v1/cli_pb.ts",
    "./ciinsights": "./src/gen/asc/v1/ciinsights_pb.ts",
    "./cloud": "./src/gen/asc/v1/cloud_pb.ts",
    "./codeintel": "./src/gen/asc/v1/codeintel_pb.ts",
    "./common": "./src/gen/asc/v1/common_pb.ts",
    "./crosssearch": "./src/gen/asc/v1/crosssearch_pb.ts",
    "./deps": "./src/gen/asc/v1/deps_pb.ts",
    "./inbox": "./src/gen/asc/v1/inbox_pb.ts",
    "./mergequeue": "./src/gen/asc/v1/mergequeue_pb.ts",
    "./policy": "./src/gen/asc/v1/policy_pb.ts",
    "./projects": "./src/gen/asc/v1/projects_pb.ts",
    "./repo": "./src/gen/asc/v1/repo_pb.ts",
    "./review": "./src/gen/asc/v1/review_pb.ts",
    "./secretscan": "./src/gen/asc/v1/secretscan_pb.ts",
    "./signing": "./src/gen/asc/v1/signing_pb.ts",
    "./stacks": "./src/gen/asc/v1/stacks_pb.ts",
    "./storage": "./src/gen/asc/v1/storage_pb.ts",
    "./vault": "./src/gen/asc/v1/vault_pb.ts",
    "./workflows": "./src/gen/asc/v1/workflows_pb.ts",
    "./workspace": "./src/gen/asc/v1/workspace_pb.ts"
  },
  "sideEffects": false,
  "scripts": {
    "codegen": "cd ../.. && buf generate proto --template proto/buf.gen.ts.yaml",
    "build": "bun build src/index.ts --target=node --format=esm --minify --outdir dist",
    "gen-allowlist": "bun scripts/gen-allowlist.ts",
    "typecheck": "tsc -p tsconfig.json",
    "test": "bun test"
  },
  "dependencies": {
    "@bufbuild/protobuf": "2",
    "openapi-fetch": "0.14.0"
  },
  "devDependencies": {
    "@bufbuild/protoc-gen-es": "2",
    "@types/bun": "^1.4.4",
    "openapi-typescript": "7.8.0",
    "typescript": "5.9.2"
  }
}
