# asc-serve.toml for a production primary. Copy, edit, and mount at /etc/asc/asc-serve.toml.
# The smoke bundle (compose.yml) carries its own loopback-only config; this one is the https shape.
# Secrets never go in this file: S3 credentials come from AWS_ACCESS_KEY_ID/AWS_SECRET_ACCESS_KEY,
# the database password from the DSN you inject, tokens from files.

listen = "0.0.0.0:7890"
# Clients use this URL. Plain http is only accepted for loopback with ASC_ALLOW_LOOPBACK_HTTP=1.
public_url = "https://asc.example.org"
# An s3 `endpoint` is https, or loopback http with ASC_ALLOW_LOOPBACK_HTTP=1; the server refuses any other http.
store = "s3://asc?endpoint=https://garage.internal:3900&region=garage&path_style=true"
db = "postgres://asc_hub@db.internal:5432/asc_hub?sslmode=verify-full&options=-csearch_path%3Dasc_hub"
cache = { memory = "4GiB", disk_dir = "/var/lib/asc/cache", disk = "50GiB" }

[auth]
provider = "token_store"            # mint tokens with `asc serve token create`
token_key_file = "/var/lib/asc/token.key"

[admin]                              # /metrics and the detailed /readyz
listen = "127.0.0.1:9464"            # a non-loopback address needs token_file
# token_file = "/etc/asc/admin-token"

[limits]
trusted_proxies = []                 # the exact /32 of your TLS proxy, if any

# A cache-role replica uses its own file:
#   role = "cache"
#   upstream = "https://asc.example.org"
#   cache = { memory = "2GiB", disk_dir = "/var/lib/asc/cache", disk = "20GiB" }

# The web UI (docs/WEB-UI.md): static files under /ui; every data call is an authenticated RPC.
# Off by default. Needs the build embedded at compile time (bun run --cwd web build, then cargo
# build) or a directory of that build.
# [web]
# enabled = true
# dir = "/opt/asc/web"                # optional: serve this build instead of the embedded one

# Bring your own storage (docs/BYOS.md). Owners add S3-compatible buckets through the Storage
# service; their credentials are sealed with the master key in [vault].
# [vault]
# key_file = "/var/lib/asc/vault.keys"   # created on first start, mode 0600; share it between replicas; back it up
#
# [netguard]                             # the rules for connecting to addresses users supply
# allow_loopback_http = false            # development only: lets a local S3 over plain http be a target
# allow_ports = []                       # besides the usual ones (denied: 22 25 3306 5432 6379 11211 2375 2379 9200)
# connect_timeout_secs = 10
# request_timeout_secs = 30
#
# [storage]
# max_targets_per_owner = 64
# max_repos_per_target = 1000
# allow_user_targets = true
# health_interval_secs = 300             # 0 turns the checks off
# repin_secs = 300
# migration_settle_secs = 5
# migration_workers = 2
