# Application environment for the asc-serve staging deployment on Coolify.
#
# Copy to a private file outside the repository, replace every CHANGE_ME, and pass it to
# `coolify-apply.sh --env-file`. Every key here becomes an environment variable of the Coolify
# application; coolify-apply.sh refuses to apply while a CHANGE_ME or an empty required value is
# left. Placeholders only: this file never holds a real value.
#
# Values are written verbatim, one KEY=VALUE per line, with no quotes. Keep values URL-safe
# (no single quote, no `$`): they are interpolated into a TOML literal string and into Compose.

# ---- Image -------------------------------------------------------------------------------------

# Required. The 12-character git sha tag of forge.example.org/asc/asc-serve. Never
# `latest`: a rollback is setting this back to the previous tag.
ASC_IMAGE_TAG=CHANGE_ME_sha12

# Optional. Numeric uid:gid the container runs as; must be the user deploy/Dockerfile.serve makes
# (the config files are owned by it, mode 0400).
ASC_RUN_UID=10001

# ---- Public address ----------------------------------------------------------------------------

# Required. Host name Coolify routes to the app (no scheme). coolify-apply.sh sets it as the
# domain of the `ascserve` service.
ASC_FQDN=asc-staging.example.org

# Required. The same host with https://, written into `public_url` (discovery document, asc clone).
ASC_PUBLIC_URL=https://asc-staging.example.org

# ---- Postgres (schema `asc` on Forgejo's server) --------------------------------------------------

# Required, secret. DSN of the least-privilege `asc` role from README.md. Percent-encode the
# password. `options=-csearch_path%3Dasc_hub` pins every connection to schema asc.
# Shape: postgres://asc_hub:<password>@<forgejo-db-host>:5432/<forgejo-db>?sslmode=prefer&options=-csearch_path%3Dasc_hub
ASC_DATABASE_URL=CHANGE_ME_postgres_dsn

# ---- Garage (S3) ---------------------------------------------------------------------------------

# Required. Garage S3 endpoint inside the platform network: http://garage-<service-uuid>:3900
# (region `garage`, path-style are fixed in the compose file). The external
# https://garage.example.org also works but leaves the platform network.
ASC_S3_ENDPOINT=http://garage-CHANGE_ME_service_uuid:3900

# Optional. Bucket created by garage-provision.sh (default asc-staging).
ASC_S3_BUCKET=asc-staging

# Required. Key id printed by garage-provision.sh. Read and write on ASC_S3_BUCKET only.
ASC_S3_ACCESS_KEY_ID=CHANGE_ME_garage_key_id

# Required, secret. Read it from the 0600 file garage-provision.sh wrote; never from chat or logs.
ASC_S3_SECRET_ACCESS_KEY=CHANGE_ME_garage_key_secret

# ---- Forgejo -------------------------------------------------------------------------------------

# Optional. Forge that receives Basic credentials from plain git and answers authorisation.
ASC_FORGEJO_URL=https://forge.example.org

# Required, secret. Forgejo's INTERNAL_TOKEN (app.ini [security]). `[forgejo]` refuses to start
# without it; it can call Forgejo's internal API, so treat it as a root-level secret.
ASC_FORGEJO_INTERNAL_TOKEN=CHANGE_ME_forgejo_internal_token

# Required, secret. Fresh random string (for example `openssl rand -hex 32`). Put the same value
# in the Forgejo webhook that posts to <ASC_PUBLIC_URL>/hooks/forgejo.
ASC_FORGEJO_WEBHOOK_SECRET=CHANGE_ME_webhook_secret

# ---- Behaviour -----------------------------------------------------------------------------------

# Optional. `[git] enabled` (SPEC 25): true serves plain git clone/fetch/push over smart-HTTP,
# false serves the disabled stub (403, X-Asc-Git). The SSH listener is not deployed.
ASC_GIT_ENABLED=true

# Optional. In-memory cache and its disk spill on the asc-state volume (`cache` in asc-serve.toml).
ASC_CACHE_MEMORY=512MiB
ASC_CACHE_DISK=5GiB

# Optional. `[limits] text_memory`: bytes of whole-file buffers all requests share. Keep it well
# under ASC_MEM_LIMIT (the default of the server, 2GiB, would not fit in the container).
ASC_TEXT_MEMORY=512MiB

# Optional. Container limits: CPUs and memory (Compose syntax, for example 2g).
ASC_CPU_LIMIT=2.0
ASC_MEM_LIMIT=2g

# Optional. RUST_LOG filter.
ASC_LOG=info
