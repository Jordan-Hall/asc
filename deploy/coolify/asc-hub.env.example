# Application environment for deploy/coolify/asc-hub.compose.yml (ASC Hub, all in one).
#
# Set these in the Coolify service's environment. Placeholders only: this file never holds a real
# value. Keep values URL-safe (no single quote, no `$`): they are interpolated into Compose and,
# for the ASC_* ones, into a TOML literal string.
#
# NOT set by you: SERVICE_PASSWORD_INTERNALTOKEN and SERVICE_PASSWORD_WEBHOOKSECRET. Coolify
# generates them (the compose file names them). The first is the secret the hub and asc share; the
# second signs the optional mirror webhook.
#
# The domain is set on the `hub` service in Coolify (https://<ASC_HUB_SSH_DOMAIN>, port 3000).
# Do not give `asc` a domain: it has no public route.

# ---- Images --------------------------------------------------------------------------------------

# Optional. Default ghcr.io/jordan-hall/asc-hub (private; the host needs `docker login ghcr.io`
# with a read:packages token).
# ASC_HUB_IMAGE_REPO=ghcr.io/jordan-hall/asc-hub

# Required. 12-character git sha tag of the hub image. Never a moving tag.
ASC_HUB_IMAGE_TAG=CHANGE_ME_sha12

# Optional. Default ghcr.io/jordan-hall/asc-serve.
# ASC_IMAGE_REPO=ghcr.io/jordan-hall/asc-serve

# Required. 12-character git sha tag of the asc-serve image.
ASC_IMAGE_TAG=CHANGE_ME_sha12

# ---- Public address ------------------------------------------------------------------------------

# Required. Public https URL of the hub (the hub's ROOT_URL; clone URLs are built from it).
ASC_HUB_ROOT_URL=https://hub.example.org

# Required. Host name only, shown in ssh clone URLs. The same host as above.
ASC_HUB_SSH_DOMAIN=hub.example.org

# Optional. Host port for git over SSH (the hub's built-in server, container port 2222). Default
# 22224 (22222 is the production Forgejo, 22223 the standalone asc staging). Open it in the host
# firewall; no TLS terminates it.
# ASC_HUB_SSH_PORT=22224

# ---- First admin ------------------------------------------------------------------------------------

# Optional. User name of the first admin (default asc-admin).
# ADMIN_USER=asc-admin

# Required. Email of the first admin. The one-shot `hub-admin` creates the user once with a random
# password in /var/lib/gitea/bootstrap/admin-password (0600, never printed); the account must
# change it at first sign-in. Registration stays off (ASC_HUB_DISABLE_REGISTRATION=true).
ADMIN_EMAIL=admin@example.org

# ---- Hub behaviour --------------------------------------------------------------------------------------

# Optional. Branding. Defaults: "ASC Hub" and "Source hosting for asc".
# ASC_HUB_APP_NAME=ASC Hub
# ASC_HUB_APP_SLOGAN=Source hosting for asc

# Optional. true (default) keeps self-registration off; sign-ups are then admin-created.
# ASC_HUB_DISABLE_REGISTRATION=true

# Optional. [asc] BRIDGE: eager (default), lazy or off. lazy needs an `asc` binary in the hub image,
# which it does not have today; see README.md "Known limits".
# ASC_HUB_BRIDGE=eager

# Optional. Hub container limits (Compose syntax).
# ASC_HUB_CPU_LIMIT=2.0
# ASC_HUB_MEM_LIMIT=1g

# ---- asc serve behaviour -----------------------------------------------------------------------------

# Optional. Container limits and cache sizes (the memory ones must fit under ASC_MEM_LIMIT).
# ASC_CPU_LIMIT=2.0
# ASC_MEM_LIMIT=1g
# ASC_CACHE_MEMORY=256MiB
# ASC_CACHE_DISK=2GiB
# ASC_TEXT_MEMORY=256MiB

# Optional. [git] enabled. Default false: git over HTTPS and SSH is served by the hub; asc has no
# public route, so its own smart-HTTP could not be reached anyway.
# ASC_GIT_ENABLED=false

# Optional. Log level filter (RUST_LOG) and format (text or json).
# ASC_LOG=info
# ASC_LOG_FORMAT=text

# ---- Upgrade: Postgres for the hub (production) ---------------------------------------------------
# Leave unset for SQLite. To switch, set all five BEFORE the first deploy (a data volume that already
# holds a SQLite database does not migrate itself; use `forgejo dump` / `restore` or a fresh volume).
# The names are the hub's own settings; the compose file passes them through.
# FORGEJO__database__DB_TYPE=postgres
# FORGEJO__database__HOST=postgres.internal:5432
# FORGEJO__database__NAME=aschub
# FORGEJO__database__USER=aschub
# FORGEJO__database__PASSWD=CHANGE_ME_hub_db_password

# ---- Upgrade: Postgres for asc ---------------------------------------------------------------------------------
# Optional. Unset means SQLite on the asc-state volume (one replica). A DSN of a role that owns schema
# `asc` only; percent-encode the password. See README.md step 2 of the asc-serve runbook.
# ASC_DATABASE_URL=postgres://asc_hub:CHANGE_ME@postgres.internal:5432/asc_hub?sslmode=prefer&options=-csearch_path%3Dasc_hub

# ---- Upgrade: S3 / Garage for asc objects ------------------------------------------------------------------
# Optional. Unset means `store = file:///var/lib/asc/objects` on the asc-state volume. Set an https
# endpoint to store objects in a bucket instead (plain http is refused by asc serve). Create the
# bucket and a read+write key first (garage-provision.sh). An existing file store is not copied.
# ASC_S3_ENDPOINT=https://garage.example.org
# ASC_S3_BUCKET=asc-hub
# ASC_S3_REGION=garage
# ASC_S3_ACCESS_KEY_ID=CHANGE_ME_garage_key_id
# ASC_S3_SECRET_ACCESS_KEY=CHANGE_ME_garage_key_secret
