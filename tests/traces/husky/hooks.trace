# Recorded by tests/traces/record/record.sh from record/scenarios/husky/hooks.sh
tool = "husky"
version = "9.1.7"
provenance = "recorded"
git = "2.55.0"
driver = "A user installs husky (the prepare script), adds a pre-commit hook that runs lint-staged, a commit-msg hook that runs commitlint, a post-checkout hook that looks for a changed lockfile and a pre-push hook that refuses a dirty work tree. They commit, commit with a rejected message, switch to a new branch, commit a partially staged file and push to a bare remote."

[[step]]
git = ["init", "-q"]
from = "driver"
exit = 0

[[step]]
sh = '''
printf "line one\nline two\nline three\nline four\nline five\nline six\nline seven\nline eight\n" > a.js
printf "{\"name\":\"fx\",\"private\":true,\"scripts\":{\"prepare\":\"husky\"}}\n" > package.json
printf "bun.lock stub\n" > bun.lock
printf ".husky/_/\n" > .gitignore
cat > .lintstagedrc.json <<"CFG"
{"*.js": "asc-act --file .semi.sh"}
CFG
cat > .semi.sh <<"TASK"
for f in "$@"; do sed -i "1s/\$/;/" "$f"; done
TASK
cat > commitlint.config.mjs <<"CFG"
export default {
  rules: {
    "type-empty": [2, "never"],
    "type-enum": [2, "always", ["feat", "fix", "chore", "docs"]],
    "subject-empty": [2, "never"],
    "header-max-length": [2, "always", 72],
  },
};
CFG
'''
from = "driver"

[[step]]
git = ["config", "core.hooksPath", ".husky/_"]
from = "husky"
exit = 0

[[step]]
sh = '''
mkdir -p .husky
cat > .husky/pre-commit <<"H"
lint-staged
H
cat > .husky/commit-msg <<"H"
commitlint --edit "$1"
H
cat > .husky/post-checkout <<"H"
git diff --name-only "$1" "$2" -- bun.lock
H
cat > .husky/pre-push <<"H"
git diff --quiet || { echo "dirty work tree"; exit 1; }
git rev-parse --abbrev-ref HEAD
H
'''
from = "driver"

[[step]]
git = ["add", "-A"]
from = "driver"
exit = 0

[[step]]
git = ["commit", "-qm", "chore: baseline"]
from = "driver"
exit = 0

[[step.hook]]
name = "pre-commit"
path = ".husky/_/pre-commit"
exit = 0

[[step.hook.call]]
git = ["-c", "submodule.recurse=false", "version", "--build-options"]
from = "husky"
routes = "real"
env = { GIT_INDEX_FILE = "${GITDIR}/index", GIT_EDITOR = ":" }
exit = 0

[[step.hook.call]]
git = ["-c", "submodule.recurse=false", "rev-parse", "--show-cdup", "--show-toplevel", "--absolute-git-dir"]
from = "husky"
env = { GIT_INDEX_FILE = "${GITDIR}/index", GIT_EDITOR = ":" }
exit = 0

[[step.hook.call]]
git = ["-c", "submodule.recurse=false", "log", "-1"]
from = "husky"
env = { GIT_INDEX_FILE = "${GITDIR}/index", GIT_EDITOR = ":" }
exit = 128

[[step.hook.call]]
git = ["-c", "submodule.recurse=false", "diff", "--diff-filter=ACMR", "--staged", "--ita-visible-in-index", "--raw", "-z"]
from = "husky"
env = { GIT_INDEX_FILE = "${GITDIR}/index", GIT_EDITOR = ":" }
exit = 0

[[step.hook.call]]
