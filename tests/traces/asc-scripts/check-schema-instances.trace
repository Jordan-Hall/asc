# Extracted from ASC scripts/check-schema-instances.ts (monorepo at dbeeef348), which lists the
# tracked files with one `git ls-files` and judges only those. The fixture stands in for ASC: a
# schema directory, one tracked and one untracked instance, a nested tree and a file with a
# name that needs quoting.
tool = "asc-scripts"
version = "dbeeef348"
provenance = "extracted"
git = "2.55.0"
source = "monorepo scripts/check-schema-instances.ts:68"
driver = "A developer or CI runs bun scripts/check-schema-instances.ts. The script runs git ls-files in the repository root with a 64 MiB output buffer and splits the result on newlines."

[[step]]
git = ["init", "-q"]
from = "driver"
exit = 0

[[step]]
sh = 'mkdir -p schemas data/nested; printf "{}\n" > schemas/a.schema.json; printf "{}\n" > data/one.json; printf "{}\n" > data/nested/two.json; printf "{}\n" > "data/with space.json"; printf "{}\n" > data/untracked.json'
from = "driver"

[[step]]
git = ["add", "schemas", "data/one.json", "data/nested", "data/with space.json"]
from = "driver"
exit = 0

[[step]]
git = ["commit", "-qm", "chore: schemas"]
from = "driver"
exit = 0

[[step]]
git = ["ls-files"]
from = "asc-scripts"
exit = 0
