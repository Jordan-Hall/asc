# Recorded by tests/traces/record/record.sh from record/scenarios/commitlint/edit-message.sh
tool = "commitlint"
version = "21.2.4"
provenance = "recorded"
git = "2.55.0"
driver = "A user checks a commit message file with commitlint --edit, once with a message that passes and once with a message that breaks the type and subject rules, the way a commit-msg hook calls it."

[[step]]
git = ["init", "-q"]
from = "driver"
exit = 0

[[step]]
sh = '''
printf "tracked\n" > a.txt
cat > commitlint.config.mjs <<"CFG"
export default {
  rules: {
    "type-empty": [2, "never"],
    "type-enum": [2, "always", ["feat", "fix", "chore", "docs"]],
    "subject-empty": [2, "never"],
    "header-max-length": [2, "always", 72],
  },
};
CFG
'''
from = "driver"

[[step]]
git = ["add", "-A"]
from = "driver"
exit = 0

[[step]]
git = ["commit", "-qm", "chore: baseline"]
from = "driver"
exit = 0

[[step]]
sh = "printf \"feat: add a feature\\n\\nA body line.\\n\" > COMMIT_MSG.txt"
from = "driver"

[[step]]
git = ["config", "core.commentChar"]
from = "commitlint"
exit = 1

[[step]]
sh = "printf \"added stuff\\n\" > COMMIT_MSG.txt"
from = "driver"

[[step]]
git = ["config", "core.commentChar"]
from = "commitlint"
exit = 1
