# Recorded by tests/traces/record/record.sh from record/scenarios/commitlint/history-range.sh
tool = "commitlint"
version = "21.2.4"
provenance = "recorded"
git = "2.55.0"
driver = "A CI step lints the commits of a branch with commitlint --from and --to, then the last commit with --last. The branch holds one valid and one invalid message."

[[step]]
git = ["init", "-q"]
from = "driver"
exit = 0

[[step]]
sh = '''
printf "one\n" > a.txt
cat > commitlint.config.mjs <<"CFG"
export default {
  rules: {
    "type-empty": [2, "never"],
    "type-enum": [2, "always", ["feat", "fix", "chore", "docs"]],
    "subject-empty": [2, "never"],
    "header-max-length": [2, "always", 72],
  },
};
CFG
'''
from = "driver"

[[step]]
git = ["add", "-A"]
from = "driver"
exit = 0

[[step]]
git = ["commit", "-qm", "chore: baseline"]
from = "driver"
exit = 0

[[step]]
git = ["checkout", "-q", "-b", "topic"]
from = "driver"
exit = 0

[[step]]
sh = "printf \"two\\n\" >> a.txt"
from = "driver"

[[step]]
git = ["commit", "-qam", "feat: second change"]
from = "driver"
exit = 0

[[step]]
sh = "printf \"three\\n\" >> a.txt"
from = "driver"

[[step]]
git = ["commit", "-qam", "third change"]
from = "driver"
exit = 0

[[step]]
git = ["merge-base", "master", "topic"]
from = "commitlint"
exit = 0

[[step]]
git = ["log", "--format=%B%n------------------------ >8 ------------------------", "--end-of-options", "master..topic"]
from = "commitlint"
exit = 0

[[step]]
git = ["log", "-1", "--pretty=format:%B"]
from = "commitlint"
exit = 0
