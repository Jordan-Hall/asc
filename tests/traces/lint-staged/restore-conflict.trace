# Recorded by tests/traces/record/record.sh from record/scenarios/lint-staged/restore-conflict.sh
tool = "lint-staged"
version = "17.6.0"
provenance = "recorded"
git = "2.55.0"
driver = "A user stages a change to line one and leaves an unstaged change to line four. The lint-staged task appends a semicolon to every line, so the hidden unstaged hunk no longer applies to the staged result. lint-staged retries the apply with --3way, and when that fails too it resets to HEAD and restores the backup stash."

[[step]]
git = ["init", "-q"]
from = "driver"
exit = 0

[[step]]
sh = '''
printf "line one\nline two\nline three\nline four\nline five\n" > a.js
cat > .lintstagedrc.json <<"CFG"
{"*.js": "asc-act --file .semi.sh"}
CFG
cat > .semi.sh <<"TASK"
for f in "$@"; do sed -i "s/\$/;/" "$f"; done
TASK
'''
from = "driver"

[[step]]
git = ["add", "-A"]
from = "driver"
exit = 0

[[step]]
git = ["commit", "-qm", "chore: baseline"]
from = "driver"
exit = 0

[[step]]
sh = "sed -i \"1s/one/ONE/\" a.js"
from = "driver"

[[step]]
git = ["add", "a.js"]
from = "driver"
exit = 0

[[step]]
sh = "sed -i \"4s/four/FOUR/\" a.js"
from = "driver"

[[step]]
git = ["-c", "submodule.recurse=false", "version", "--build-options"]
from = "lint-staged"
routes = "real"
exit = 0

[[step]]
git = ["-c", "submodule.recurse=false", "rev-parse", "--show-cdup", "--show-toplevel", "--absolute-git-dir"]
from = "lint-staged"
exit = 0

[[step]]
git = ["-c", "submodule.recurse=false", "log", "-1"]
from = "lint-staged"
exit = 0

[[step]]
git = ["-c", "submodule.recurse=false", "diff", "--diff-filter=ACMR", "--staged", "--ita-visible-in-index", "--raw", "-z"]
from = "lint-staged"
exit = 0

[[step]]
git = ["-c", "submodule.recurse=false", "diff", "--staged", "--ita-visible-in-index", "--name-only", "-z"]
from = "lint-staged"
exit = 0

[[step]]
git = ["-c", "submodule.recurse=false", "diff", "--staged", "--ita-invisible-in-index", "--name-only", "-z"]
from = "lint-staged"
exit = 0

[[step]]
git = ["-c", "submodule.recurse=false", "ls-files", "-z", "--full-name", "-t", "--cached", "--others", "--exclude-standard", "--", ":(glob)**/package.json", ":(glob)**/package.yaml", ":(glob)**/package.yml", ":(glob)**/.lintstagedrc", ":(glob)**/.lintstagedrc.json", ":(glob)**/.lintstagedrc.yaml", ":(glob)**/.lintstagedrc.yml", ":(glob)**/.lintstagedrc.mjs", ":(glob)**/.lintstagedrc.mts", ":(glob)**/.lintstagedrc.js", ":(glob)**/.lintstagedrc.ts", ":(glob)**/.lintstagedrc.cjs", ":(glob)**/.lintstagedrc.cts", ":(glob)**/lint-staged.config.mjs", ":(glob)**/lint-staged.config.mts", ":(glob)**/lint-staged.config.js", ":(glob)**/lint-staged.config.ts", ":(glob)**/lint-staged.config.cjs", ":(glob)**/lint-staged.config.cts"]
from = "lint-staged"
exit = 0

[[step]]
git = ["-c", "submodule.recurse=false", "status", "-z", "--untracked-files=no"]
from = "lint-staged"
exit = 0

[[step]]
sh = "mkdir -p \"$(dirname \"${GITDIR}/lint-staged/f380501d/unstaged.patch\")\""
from = "lint-staged"

[[step]]
git = ["-c", "submodule.recurse=false", "diff", "--binary", "--unified=0", "--no-color", "--no-ext-diff", "--src-prefix=a/", "--dst-prefix=b/", "--patch", "--submodule=short", "--output", "${GITDIR}/lint-staged/f380501d/unstaged.patch", "--", "a.js"]
from = "lint-staged"
exit = 0

[[step]]
git = ["-c", "submodule.recurse=false", "stash", "create"]
from = "lint-staged"
exit = 0

[[step]]
git = ["-c", "submodule.recurse=false", "stash", "store", "--quiet", "--message", "lint-staged automatic backup (f380501d)", "c206f965c428fd1718718cd652342cc83de3fc4b"]
from = "lint-staged"
exit = 0

[[step]]
git = ["-c", "submodule.recurse=false", "rev-parse", "--short", "c206f965c428fd1718718cd652342cc83de3fc4b"]
from = "lint-staged"
exit = 0

[[step]]
git = ["-c", "submodule.recurse=false", "restore", "--worktree", "--", "a.js"]
from = "lint-staged"
exit = 0

[[step]]
git = ["-c", "submodule.recurse=false", "diff", "--binary", "--unified=0", "--no-color", "--no-ext-diff", "--src-prefix=a/", "--dst-prefix=b/", "--patch", "--submodule=short", "--raw", "-z", "--no-renames", "--no-textconv"]
from = "lint-staged"
exit = 0

[[step]]
sh = "set -- \"${ROOT}/a.js\"; for f in \"$@\"; do sed -i \"s/\\$/;/\" \"$f\"; done"
from = "lint-staged"

[[step]]
git = ["-c", "submodule.recurse=false", "diff", "--binary", "--unified=0", "--no-color", "--no-ext-diff", "--src-prefix=a/", "--dst-prefix=b/", "--patch", "--submodule=short", "--raw", "-z", "--no-renames", "--no-textconv"]
from = "lint-staged"
exit = 0

[[step]]
git = ["-c", "submodule.recurse=false", "add", "--", "${ROOT}/a.js"]
from = "lint-staged"
exit = 0

[[step]]
git = ["-c", "submodule.recurse=false", "diff", "--diff-filter=ACMR", "--staged", "--name-only", "-z"]
from = "lint-staged"
exit = 0

[[step]]
git = ["-c", "submodule.recurse=false", "apply", "-v", "--whitespace=nowarn", "--recount", "--unidiff-zero", "${GITDIR}/lint-staged/f380501d/unstaged.patch"]
from = "lint-staged"
exit = 1

[[step]]
git = ["-c", "submodule.recurse=false", "apply", "-v", "--whitespace=nowarn", "--recount", "--unidiff-zero", "--3way", "${GITDIR}/lint-staged/f380501d/unstaged.patch"]
from = "lint-staged"
exit = 1

[[step]]
git = ["-c", "submodule.recurse=false", "reset", "--hard", "HEAD"]
from = "lint-staged"
exit = 0

[[step]]
git = ["-c", "submodule.recurse=false", "stash", "apply", "--quiet", "--index", "c206f965c428fd1718718cd652342cc83de3fc4b"]
from = "lint-staged"
exit = 0

[[step]]
git = ["-c", "submodule.recurse=false", "stash", "list", "--format=\"%H %s\"", "-z"]
from = "lint-staged"
exit = 0

[[step]]
git = ["-c", "submodule.recurse=false", "stash", "drop", "--quiet", "0"]
from = "lint-staged"
exit = 0

[[step]]
git = ["status", "--porcelain=v1"]
from = "driver"
exit = 0

[[step]]
git = ["diff", "--cached"]
from = "driver"
exit = 0

[[step]]
git = ["diff"]
from = "driver"
exit = 0

[[step]]
git = ["stash", "list"]
from = "driver"
exit = 0
