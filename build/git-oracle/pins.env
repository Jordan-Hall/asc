# The pinned git oracle (docs/git-fidelity.md, "The pinned version"). Plain KEY=VALUE lines: this
# file is read by oracle.sh (sourced), by deploy/Dockerfile.serve through oracle.sh, by
# tests/compat/src/lib.rs (parsed) and by CI, which keys its cache on the hash of this file.
# A bump changes every line that names a version and every digest, in one change.

# Linux (and the server image): git built from the upstream source tarball.
GIT_VERSION=2.55.0
GIT_TARBALL=git-2.55.0.tar.xz
GIT_TARBALL_URL=https://mirrors.edge.kernel.org/pub/software/scm/git/git-2.55.0.tar.xz
GIT_TARBALL_SHA256=457fdb04dc8728e007d4688695e6912e6f680727920f2a40bf11eacc17505357

# Windows: MinGit from Git for Windows. The release asset's digest is the one GitHub publishes.
GFW_VERSION=2.55.0.windows.5
GFW_ASSET=MinGit-2.55.0.5-64-bit.zip
GFW_URL=https://github.com/git-for-windows/git/releases/download/v2.55.0.windows.5/MinGit-2.55.0.5-64-bit.zip
GFW_SHA256=56d7b226b7693196cfc71fef26568f536c4a021ab6c37ff2db4287bed908e96e
