<idea-plugin>
  <id>asc.asc</id>
  <name>ASC</name>
  <vendor>ASC</vendor>
  <description>Version control for ASC workspaces: stacks, review and history, through the asc bridge.</description>
  <depends>com.intellij.modules.platform</depends>
  <depends>com.intellij.modules.vcs</depends>
  <extensions defaultExtensionNs="com.intellij">
    <applicationService serviceImplementation="asc.asc.bridge.AscBridgeService"/>
    <vcs name="asc" vcsClass="asc.asc.vcs.AscVcs" displayName="asc"/>
    <vcsRootChecker implementation="asc.asc.vcs.AscRootChecker"/>
    <postStartupActivity implementation="asc.asc.vcs.AscMappingActivity"/>
    <postStartupActivity implementation="asc.asc.vcs.AscWatchStartup"/>
    <projectService serviceImplementation="asc.asc.vcs.AscWatchService"/>
    <vcs.changes.localCommitExecutor implementation="asc.asc.vcs.AscSubmitExecutor"/>
    <vcs.ignoredFileProvider implementation="asc.asc.vcs.AscIgnoreProvider"/>
    <directoryIndexExcludePolicy implementation="asc.asc.vcs.AscIndexExcludePolicy"/>
    <postStartupActivity implementation="asc.asc.vcs.AscHydrationWatch"/>
    <notificationGroup id="asc" displayType="BALLOON"/>
    <statusBarWidgetFactory id="asc.asc.status" implementation="asc.asc.ui.AscStatusBarWidgetFactory"/>
  </extensions>
  <actions>
    <group id="asc.asc.StackActions" text="asc" popup="true">
      <add-to-group group-id="VcsGroups" anchor="last"/>
      <action id="asc.asc.Up" class="asc.asc.ui.AscUpAction" text="Move Up the Stack"/>
      <action id="asc.asc.Down" class="asc.asc.ui.AscDownAction" text="Move Down the Stack"/>
      <action id="asc.asc.Restack" class="asc.asc.ui.AscRestackAction" text="Restack"/>
      <action id="asc.asc.Sync" class="asc.asc.ui.AscSyncAction" text="Sync"/>
      <action id="asc.asc.Submit" class="asc.asc.ui.AscSubmitAction" text="Submit"/>
      <action id="asc.asc.Absorb" class="asc.asc.ui.AscAbsorbAction" text="Absorb"/>
      <action id="asc.asc.Undo" class="asc.asc.ui.AscUndoAction" text="Undo"/>
      <action id="asc.asc.Redo" class="asc.asc.ui.AscRedoAction" text="Redo"/>
      <action id="asc.asc.ConfigureAgents" class="asc.asc.ui.AscConfigureAgentsAction" text="Configure Agents"/>
    </group>
  </actions>
</idea-plugin>
