{
  "comments": { "lineComment": "//", "blockComment": ["/*", "*/"] },
  "brackets": [
    ["{", "}"],
    ["[", "]"],
    ["(", ")"]
  ],
  "autoClosingPairs": [
    { "open": "{", "close": "}" },
    { "open": "[", "close": "]" },
    { "open": "(", "close": ")" },
    { "open": "'", "close": "'", "notIn": ["string", "comment"] },
    { "open": "\"", "close": "\"", "notIn": ["string"] },
    { "open": "`", "close": "`", "notIn": ["string", "comment"] },
    { "open": "/*", "close": " */", "notIn": ["string"] }
  ],
  "surroundingPairs": [
    ["{", "}"],
    ["[", "]"],
    ["(", ")"],
    ["'", "'"],
    ["\"", "\""],
    ["`", "`"],
    ["<", ">"]
  ],
  "wordPattern": "[A-Za-z_$][\w$]*",
  "indentationRules": {
    "increaseIndentPattern": "^.*(\{[^}\"'`]*|\([^)\"'`]*|<[A-Za-z][^/>]*>)\s*$",
    "decreaseIndentPattern": "^\s*(\}|\)|</[A-Za-z])"
  }
}
