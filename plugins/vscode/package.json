      "scm/resourceState/context": [
        {
          "command": "asc.stageFile",
          "when": "scmProvider == asc && scmResourceGroup =~ /^(changes|untracked)$/",
          "group": "inline@1"
        },
        {
          "command": "asc.unstageFile",
          "when": "scmProvider == asc && scmResourceGroup == staged",
          "group": "inline@1"
        },
        {
          "command": "asc.discard",
          "when": "scmProvider == asc && scmResourceGroup == changes",
          "group": "inline@2"
        },
        {
          "command": "asc.stageFile",
          "when": "scmProvider == asc && scmResourceGroup =~ /^(changes|untracked)$/",
          "group": "1_modification@1"
        },
        {
          "command": "asc.unstageFile",
          "when": "scmProvider == asc && scmResourceGroup == staged",
          "group": "1_modification@1"
        },
        {
          "command": "asc.discard",
          "when": "scmProvider == asc && scmResourceGroup == changes",
          "group": "1_modification@2"
        },
        {
          "command": "asc.addToAscignore",
          "when": "scmProvider == asc && scmResourceGroup == untracked",
          "group": "2_ignore@1"
        },
        {
          "command": "asc.conflicts.open",
          "when": "scmProvider == asc && scmResourceGroup == conflicts",
          "group": "1_conflict@1"
