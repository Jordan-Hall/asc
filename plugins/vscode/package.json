    "mcpServerDefinitionProviders": [
      {
        "id": "asc",
        "label": "asc"
      }
    ],
    "taskDefinitions": [
      {
        "type": "asc",
        "required": [
          "root",
          "project",
          "target"
        ],
        "properties": {
          "root": {
            "type": "string",
            "description": "The asc workspace root."
          },
          "project": {
            "type": "string",
            "description": "The project id."
          },
          "target": {
            "type": "string",
            "description": "The target name."
          }
        }
      }
    ],
    "keybindings": [
      {
        "command": "asc.stackUp",
        "key": "ctrl+k ctrl+alt+up",
        "mac": "cmd+k cmd+alt+up",
        "when": "asc.workspace && asc.mutating"
      },
      {
        "command": "asc.stackDown",
        "key": "ctrl+k ctrl+alt+down",
        "mac": "cmd+k cmd+alt+down",
        "when": "asc.workspace && asc.mutating"
      },
      {
        "command": "asc.stackTop",
        "key": "ctrl+k ctrl+alt+home",
        "mac": "cmd+k cmd+alt+home",
        "when": "asc.workspace && asc.mutating"
      },
      {
        "command": "asc.stackBottom",
        "key": "ctrl+k ctrl+alt+end",
        "mac": "cmd+k cmd+alt+end",
        "when": "asc.workspace && asc.mutating"
      }
    ]
