{
  "name": "asc",
  "displayName": "ASC",
  "description": "ASC source control for VS Code",
  "icon": "icon.png",
  "publisher": "asc",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "license": "UNLICENSED",
  "repository": {
    "type": "git",
    "url": "https://forge.example.org/asc/source-control"
  },
  "engines": {
    "vscode": "^1.101.0"
  },
  "categories": [
    "SCM Providers"
  ],
  "main": "./dist/extension.cjs",
  "activationEvents": [
    "workspaceContains:.git",
    "onFileSystem:asc",
    "onUri",
    "onWebviewPanel:asc.graph",
    "onWebviewPanel:asc.review",
    "onWebviewPanel:asc.history",
    "onMcpCollection:asc"
  ],
  "capabilities": {
    "untrustedWorkspaces": {
      "supported": "limited",
      "description": "asc runs only in trusted workspaces because it starts the asc executable.",
      "restrictedConfigurations": [
        "asc.path",
        "asc.mcp.serverUrl"
      ]
    },
    "virtualWorkspaces": false
  },
  "contributes": {
    "configuration": {
      "title": "ASC",
      "properties": {
        "asc.path": {
          "type": "string",
          "default": "",
          "scope": "machine",
          "markdownDescription": "Path to the `asc` executable. Empty searches `PATH`, then `$ASC_HOME/bin`."
        },
        "asc.blame.inline": {
          "type": "boolean",
          "default": true,
          "description": "Show the blame of the current line after it."
        },
        "asc.blame.codeLens": {
          "type": "boolean",
          "default": true,
          "description": "Show who last changed each top-level symbol. Off for files over 5,000 lines."
        },
        "asc.mcp.serverUrl": {
          "type": "string",
          "default": "",
          "scope": "machine",
          "markdownDescription": "An `https://` asc server for `asc mcp --remote`, used only when no asc workspace is open."
        },
        "asc.inbox.statusBar": {
          "type": "boolean",
          "default": true,
          "description": "Show the count of changes that need your review in the status bar."
        }
      }
    },
    "commands": [
      {
        "command": "asc.restartBridge",
        "title": "Restart the bridge",
        "category": "asc"
      },
      {
        "command": "asc.diffAgainstStackParent",
        "title": "Diff against stack parent",
        "category": "asc"
      },
      {
        "command": "asc.showOutput",
        "title": "Show output",
        "category": "asc"
      },
      {
        "command": "asc.openGraph",
        "title": "Open graph",
        "category": "asc",
        "enablement": "asc.workspace"
      },
      {
        "command": "asc.openReview",
        "title": "Open review",
        "category": "asc",
        "enablement": "asc.workspace"
      },
      {
        "command": "asc.openHistory",
        "title": "Open history",
        "category": "asc",
        "enablement": "asc.workspace"
      },
      {
        "command": "asc.openProject",
        "title": "Open project graph",
        "category": "asc",
        "enablement": "asc.workspace"
      },
      {
        "command": "asc.openSearch",
        "title": "Open search",
        "category": "asc",
        "enablement": "asc.workspace"
      },
      {
        "command": "asc.blame.toggleFile",
        "title": "Toggle file blame",
        "category": "asc",
        "enablement": "asc.workspace"
      },
      {
        "command": "asc.blame.toggleHeatmap",
        "title": "Toggle blame heatmap",
        "category": "asc",
        "enablement": "asc.workspace"
      },
      {
        "command": "asc.blame.toggleInline",
        "title": "Toggle inline blame",
        "category": "asc",
        "enablement": "asc.workspace"
      },
      {
        "command": "asc.create",
        "title": "Create change",
        "category": "asc",
        "enablement": "asc.workspace && asc.mutating"
      },
      {
        "command": "asc.amend",
        "title": "Amend current change",
        "category": "asc",
        "enablement": "asc.workspace && asc.mutating",
        "icon": "$(edit)"
      },
      {
        "command": "asc.reword",
        "title": "Reword current change",
        "category": "asc",
        "enablement": "asc.workspace && asc.mutating"
      },
      {
        "command": "asc.absorb",
        "title": "Absorb into stack",
        "category": "asc",
        "enablement": "asc.workspace && asc.mutating"
      },
      {
        "command": "asc.undo",
        "title": "Undo last operation",
        "category": "asc",
        "enablement": "asc.workspace && asc.mutating",
        "icon": "$(discard)"
      },
      {
        "command": "asc.redo",
        "title": "Redo last undone operation",
        "category": "asc",
        "enablement": "asc.workspace && asc.mutating",
        "icon": "$(redo)"
      },
      {
        "command": "asc.discard",
        "title": "Discard changes",
        "category": "asc",
        "enablement": "asc.workspace && asc.mutating",
        "icon": "$(discard)"
      },
      {
        "command": "asc.stageFile",
        "title": "Stage file",
        "category": "asc",
        "enablement": "asc.workspace && asc.mutating",
        "icon": "$(add)"
      },
      {
        "command": "asc.unstageFile",
        "title": "Unstage file",
        "category": "asc",
        "enablement": "asc.workspace && asc.mutating",
        "icon": "$(remove)"
      },
      {
        "command": "asc.stageSelectedRanges",
        "title": "Stage selected ranges",
        "category": "asc",
        "enablement": "asc.workspace && asc.mutating"
      },
      {
        "command": "asc.unstageSelectedRanges",
        "title": "Unstage selected ranges",
        "category": "asc",
        "enablement": "asc.workspace && asc.mutating"
      },
      {
        "command": "asc.stageChange",
        "title": "Stage change",
        "category": "asc",
        "enablement": "asc.workspace && asc.mutating",
        "icon": "$(add)"
      },
      {
        "command": "asc.unstageChange",
        "title": "Unstage change",
        "category": "asc",
        "enablement": "asc.workspace && asc.mutating",
        "icon": "$(remove)"
      },
      {
        "command": "asc.uncommit",
        "title": "Uncommit",
        "category": "asc",
        "enablement": "asc.workspace && asc.mutating"
      },
      {
        "command": "asc.unamend",
        "title": "Unamend",
        "category": "asc",
        "enablement": "asc.workspace && asc.mutating"
      },
      {
        "command": "asc.abandon",
        "title": "Abandon change",
        "category": "asc",
        "enablement": "asc.workspace && asc.mutating"
      },
      {
        "command": "asc.restack",
        "title": "Restack",
        "category": "asc",
        "enablement": "asc.workspace && asc.mutating"
      },
      {
        "command": "asc.restackOntoTrunk",
        "title": "Restack onto trunk",
        "category": "asc",
        "enablement": "asc.workspace && asc.mutating"
      },
      {
        "command": "asc.openSmartlog",
        "title": "Open smartlog",
        "category": "asc",
        "enablement": "asc.workspace"
      },
      {
        "command": "asc.stashPush",
        "title": "Stash changes",
        "category": "asc",
        "enablement": "asc.workspace && asc.mutating"
      },
      {
        "command": "asc.stashPushUntracked",
        "title": "Stash changes including untracked",
        "category": "asc",
        "enablement": "asc.workspace && asc.mutating"
      },
      {
        "command": "asc.stashPop",
        "title": "Pop stash",
        "category": "asc",
        "enablement": "asc.workspace && asc.mutating"
      },
      {
        "command": "asc.stashApply",
        "title": "Apply stash",
        "category": "asc",
        "enablement": "asc.workspace && asc.mutating"
      },
      {
        "command": "asc.stashDrop",
        "title": "Drop stash",
        "category": "asc",
        "enablement": "asc.workspace && asc.mutating"
      },
      {
        "command": "asc.fetch",
        "title": "Fetch",
        "category": "asc",
        "enablement": "asc.workspace && asc.gitRemote"
      },
      {
        "command": "asc.pull",
        "title": "Pull",
        "category": "asc",
        "enablement": "asc.workspace && asc.mutating && asc.gitRemote"
      },
      {
        "command": "asc.push",
        "title": "Push",
        "category": "asc",
        "enablement": "asc.workspace && asc.mutating && asc.gitRemote"
      },
      {
        "command": "asc.addToAscignore",
        "title": "Add to .ascignore",
        "category": "asc",
        "enablement": "asc.workspace"
      },
      {
        "command": "asc.stackUp",
        "title": "Stack: go up",
        "category": "asc",
        "enablement": "asc.workspace && asc.mutating"
      },
      {
        "command": "asc.stackDown",
        "title": "Stack: go down",
        "category": "asc",
        "enablement": "asc.workspace && asc.mutating"
      },
      {
        "command": "asc.stackTop",
        "title": "Stack: go to the top",
        "category": "asc",
        "enablement": "asc.workspace && asc.mutating"
      },
      {
        "command": "asc.stackBottom",
        "title": "Stack: go to the bottom",
        "category": "asc",
        "enablement": "asc.workspace && asc.mutating"
      },
      {
        "command": "asc.stackRestack",
        "title": "Restack the stack",
        "category": "asc",
        "enablement": "asc.workspace && asc.mutating",
        "icon": "$(versions)"
      },
      {
        "command": "asc.stackSync",
        "title": "Sync the stack",
        "category": "asc",
        "enablement": "asc.workspace && asc.mutating",
        "icon": "$(sync)"
      },
      {
        "command": "asc.stackSubmit",
        "title": "Submit the stack",
        "category": "asc",
        "enablement": "asc.workspace && asc.mutating",
        "icon": "$(cloud-upload)"
      },
      {
        "command": "asc.stackShare",
        "title": "Copy share link for the current change",
        "category": "asc",
        "enablement": "asc.workspace"
      },
      {
        "command": "asc.conflicts.pick",
        "title": "Open a conflict",
        "category": "asc",
        "enablement": "asc.workspace"
      },
      {
        "command": "asc.conflicts.open",
        "title": "Open conflict",
        "category": "asc",
        "enablement": "asc.workspace"
      },
      {
        "command": "asc.conflicts.markResolved",
        "title": "Mark conflict resolved",
        "category": "asc",
        "enablement": "asc.workspace && asc.mutating"
      },
      {
        "command": "asc.continue",
        "title": "Continue the paused operation",
        "category": "asc",
        "enablement": "asc.workspace && asc.mutating"
      },
      {
        "command": "asc.abort",
        "title": "Abort the paused operation",
        "category": "asc",
        "enablement": "asc.workspace && asc.mutating"
      },
      {
        "command": "asc.worktrees.add",
        "title": "Add worktree",
        "category": "asc",
        "enablement": "asc.workspace && asc.mutating",
        "icon": "$(add)"
      },
      {
        "command": "asc.worktrees.open",
        "title": "Open worktree in new window",
        "category": "asc",
        "enablement": "asc.workspace",
        "icon": "$(multiple-windows)"
      },
      {
        "command": "asc.worktrees.remove",
        "title": "Remove worktree",
        "category": "asc",
        "enablement": "asc.workspace && asc.mutating",
        "icon": "$(trash)"
      },
      {
        "command": "asc.worktrees.lock",
        "title": "Lock worktree",
        "category": "asc",
        "enablement": "asc.workspace",
        "icon": "$(lock)"
      },
      {
        "command": "asc.oplog.loadMore",
        "title": "Load more operations",
        "category": "asc",
        "enablement": "asc.workspace"
      },
      {
        "command": "asc.fileHistory.loadMore",
        "title": "Load more history",
        "category": "asc",
        "enablement": "asc.workspace"
      },
      {
        "command": "asc.fileHistory.fileMode",
        "title": "File history: whole file",
        "category": "asc",
        "enablement": "asc.workspace",
        "icon": "$(file)"
      },
      {
        "command": "asc.fileHistory.lineMode",
        "title": "File history: selected lines",
        "category": "asc",
        "enablement": "asc.workspace",
        "icon": "$(list-selection)"
      },
      {
        "command": "asc.revnav.previous",
        "title": "Previous version of this file",
        "category": "asc",
        "enablement": "asc.workspace",
        "icon": "$(arrow-left)"
      },
      {
        "command": "asc.revnav.next",
        "title": "Next version of this file",
        "category": "asc",
        "enablement": "asc.workspace",
        "icon": "$(arrow-right)"
      },
      {
        "command": "asc.affected.refresh",
        "title": "Refresh affected projects",
        "category": "asc",
        "enablement": "asc.workspace",
        "icon": "$(refresh)"
      },
      {
        "command": "asc.affected.run",
        "title": "Run target",
        "category": "asc",
        "enablement": "asc.workspace",
        "icon": "$(play)"
      },
      {
        "command": "asc.review.checkoutStack",
        "title": "Check out stack",
        "category": "asc",
        "enablement": "asc.workspace && asc.mutating"
      },
      {
        "command": "asc.searchCode",
        "title": "Search code",
        "category": "asc",
        "enablement": "asc.workspace",
        "icon": "$(search)"
      },
      {
        "command": "asc.configureAgents",
        "title": "Configure agents",
        "category": "asc",
        "enablement": "asc.workspace"
      },
      {
        "command": "asc.inbox.refresh",
        "title": "Refresh inbox",
        "category": "asc",
        "enablement": "asc.workspace && asc.feature.inbox",
        "icon": "$(refresh)"
      },
      {
        "command": "asc.inbox.pin",
        "title": "Pin",
        "category": "asc",
        "enablement": "asc.workspace && asc.feature.inbox",
        "icon": "$(pin)"
      },
      {
        "command": "asc.inbox.unpin",
        "title": "Unpin",
        "category": "asc",
        "enablement": "asc.workspace && asc.feature.inbox",
        "icon": "$(pinned)"
      },
      {
        "command": "asc.inbox.snooze",
        "title": "Snooze",
        "category": "asc",
        "enablement": "asc.workspace && asc.feature.inbox",
        "icon": "$(bell-slash)"
      },
      {
        "command": "asc.inbox.checkout",
        "title": "Check out stack",
        "category": "asc",
        "enablement": "asc.workspace && asc.feature.inbox && asc.mutating",
        "icon": "$(repo-pull)"
      },
      {
        "command": "asc.review.showThreads",
        "title": "Show review threads for the current change",
        "category": "asc",
        "enablement": "asc.workspace && asc.feature.review"
      },
      {
        "command": "asc.review.requestReview",
        "title": "Request a review of the current change",
        "category": "asc",
        "enablement": "asc.workspace && asc.feature.review"
      },
      {
        "command": "asc.review.createComment",
        "title": "Comment",
        "category": "asc",
        "enablement": "asc.workspace && asc.feature.review"
      },
      {
        "command": "asc.review.resolveThread",
        "title": "Resolve thread",
        "category": "asc",
        "enablement": "asc.workspace && asc.feature.review"
      },
      {
        "command": "asc.review.reopenThread",
        "title": "Reopen thread",
        "category": "asc",
        "enablement": "asc.workspace && asc.feature.review"
      },
      {
        "command": "asc.actions.refresh",
        "title": "Refresh Actions",
        "category": "asc",
        "enablement": "asc.workspace && asc.feature.ci",
        "icon": "$(refresh)"
      },
      {
        "command": "asc.actions.loadEarlier",
        "title": "Load earlier log output",
        "category": "asc",
        "enablement": "asc.workspace && asc.feature.ci"
      }
    ],
    "views": {
      "scm": [
        {
          "type": "webview",
          "id": "asc.smartlog",
          "name": "asc Smartlog",
          "when": "asc.workspace"
        }
      ],
      "asc": [
        {
          "id": "asc.inbox",
          "name": "Inbox",
          "when": "asc.workspace && asc.feature.inbox"
        },
        {
          "id": "asc.worktrees",
          "name": "Worktrees",
          "when": "asc.workspace"
        },
        {
          "id": "asc.affected",
          "name": "Affected",
          "when": "asc.workspace"
        },
        {
          "id": "asc.oplog",
          "name": "Op log",
          "when": "asc.workspace"
        },
        {
          "id": "asc.actions",
          "name": "Actions",
          "when": "asc.workspace && asc.feature.ci"
        }
      ],
      "explorer": [
        {
          "id": "asc.fileHistory",
          "name": "asc File History",
          "when": "asc.workspace"
        }
      ]
    },
    "colors": [
      {
        "id": "asc.blameForeground",
        "description": "Inline blame text.",
        "defaults": {
          "dark": "#8b8b8b99",
          "light": "#7b7b7b99",
          "highContrast": "#cccccc",
          "highContrastLight": "#333333"
        }
      },
      {
        "id": "asc.heatmap0",
        "description": "Blame heatmap, age quantile 0 (0 oldest).",
        "defaults": {
          "dark": "#3b4a7a",
          "light": "#3b4a7a",
          "highContrast": "#3b4a7a",
          "highContrastLight": "#3b4a7a"
        }
      },
      {
        "id": "asc.heatmap1",
        "description": "Blame heatmap, age quantile 1 (0 oldest).",
        "defaults": {
          "dark": "#3f6a8a",
          "light": "#3f6a8a",
          "highContrast": "#3f6a8a",
          "highContrastLight": "#3f6a8a"
        }
      },
      {
        "id": "asc.heatmap2",
        "description": "Blame heatmap, age quantile 2 (0 oldest).",
        "defaults": {
          "dark": "#3f8a7a",
          "light": "#3f8a7a",
          "highContrast": "#3f8a7a",
          "highContrastLight": "#3f8a7a"
        }
      },
      {
        "id": "asc.heatmap3",
        "description": "Blame heatmap, age quantile 3 (0 oldest).",
        "defaults": {
          "dark": "#8a9a3f",
          "light": "#8a9a3f",
          "highContrast": "#8a9a3f",
          "highContrastLight": "#8a9a3f"
        }
      },
      {
        "id": "asc.heatmap4",
        "description": "Blame heatmap, age quantile 4 (0 oldest).",
        "defaults": {
          "dark": "#d19a3f",
          "light": "#d19a3f",
          "highContrast": "#d19a3f",
          "highContrastLight": "#d19a3f"
        }
      }
    ],
    "viewsContainers": {
      "activitybar": [
        {
          "id": "asc",
          "title": "asc",
          "icon": "icon.png"
        }
      ]
    },
    "menus": {
      "view/item/context": [
        {
          "command": "asc.worktrees.open",
          "when": "view == asc.worktrees && viewItem =~ /^asc\\.worktree/",
          "group": "inline@1"
        },
        {
          "command": "asc.worktrees.remove",
          "when": "view == asc.worktrees && viewItem == asc.worktree",
          "group": "inline@2"
        },
        {
          "command": "asc.worktrees.lock",
          "when": "view == asc.worktrees && viewItem == asc.worktree",
          "group": "1_manage"
        },
        {
          "command": "asc.affected.run",
          "when": "view == asc.affected && viewItem == asc.affected.target",
          "group": "inline"
        },
        {
          "command": "asc.inbox.pin",
          "when": "view == asc.inbox && viewItem == asc.inbox.item",
          "group": "inline@1"
        },
        {
          "command": "asc.inbox.unpin",
          "when": "view == asc.inbox && viewItem == asc.inbox.pinned",
          "group": "inline@1"
        },
        {
          "command": "asc.inbox.snooze",
          "when": "view == asc.inbox && viewItem =~ /^asc\\.inbox\\.(item|pinned)$/",
          "group": "inline@2"
        },
        {
          "command": "asc.inbox.checkout",
          "when": "view == asc.inbox && viewItem =~ /^asc\\.inbox\\.(item|pinned)$/",
          "group": "inline@3"
        }
      ],
      "view/title": [
        {
          "command": "asc.worktrees.add",
          "when": "view == asc.worktrees",
          "group": "navigation"
        },
        {
          "command": "asc.affected.refresh",
          "when": "view == asc.affected",
          "group": "navigation"
        },
        {
          "command": "asc.fileHistory.fileMode",
          "when": "view == asc.fileHistory",
          "group": "navigation@1"
        },
        {
          "command": "asc.fileHistory.lineMode",
          "when": "view == asc.fileHistory",
          "group": "navigation@2"
        },
        {
          "command": "asc.inbox.refresh",
          "when": "view == asc.inbox",
          "group": "navigation"
        },
        {
          "command": "asc.actions.refresh",
          "when": "view == asc.actions",
          "group": "navigation"
        }
      ],
      "commandPalette": [
        {
          "command": "asc.stageChange",
          "when": "false"
        },
        {
          "command": "asc.unstageChange",
          "when": "false"
        },
        {
          "command": "asc.stageFile",
          "when": "false"
        },
        {
          "command": "asc.unstageFile",
          "when": "false"
        },
        {
          "command": "asc.discard",
          "when": "false"
        },
        {
          "command": "asc.addToAscignore",
          "when": "false"
        },
        {
          "command": "asc.conflicts.open",
          "when": "false"
        },
        {
          "command": "asc.oplog.loadMore",
          "when": "false"
        },
        {
          "command": "asc.fileHistory.loadMore",
          "when": "false"
        },
        {
          "command": "asc.affected.run",
          "when": "false"
        },
        {
          "command": "asc.worktrees.open",
          "when": "false"
        },
        {
          "command": "asc.worktrees.remove",
          "when": "false"
        },
        {
          "command": "asc.worktrees.lock",
          "when": "false"
        },
        {
          "command": "asc.inbox.pin",
          "when": "false"
        },
        {
          "command": "asc.inbox.unpin",
          "when": "false"
        },
        {
          "command": "asc.inbox.snooze",
          "when": "false"
        },
        {
          "command": "asc.inbox.checkout",
          "when": "false"
        },
        {
          "command": "asc.review.createComment",
          "when": "false"
        },
        {
          "command": "asc.review.resolveThread",
          "when": "false"
        },
        {
          "command": "asc.review.reopenThread",
          "when": "false"
        }
      ],
      "scm/title": [
        {
          "command": "asc.stackSubmit",
          "when": "scmProvider == asc",
          "group": "navigation@1"
        },
        {
          "command": "asc.stackSync",
          "when": "scmProvider == asc",
