        {
          "command": "asc.unstageChange",
          "when": "originalResourceScheme == asc",
          "group": "inline@2"
        }
      ],
      "editor/context": [
        {
          "command": "asc.stageSelectedRanges",
          "when": "asc.workspace && resourceScheme == file && !editorReadonly",
          "group": "asc@1"
        },
        {
          "command": "asc.unstageSelectedRanges",
          "when": "asc.workspace && resourceScheme == file && !editorReadonly",
          "group": "asc@2"
        },
        {
          "command": "asc.diffAgainstStackParent",
          "when": "asc.workspace && resourceScheme == file",
          "group": "asc@3"
        }
      ],
      "editor/title": [
        {
          "command": "asc.revnav.previous",
          "when": "asc.workspace && (resourceScheme == file || resourceScheme == asc)",
          "group": "navigation@10"
        },
        {
          "command": "asc.revnav.next",
          "when": "asc.workspace && (resourceScheme == file || resourceScheme == asc)",
          "group": "navigation@11"
        },
        {
          "command": "asc.actions.loadEarlier",
          "when": "resourceScheme == asc-actions",
          "group": "navigation"
        }
      ],
      "comments/commentThread/title": [
        {
          "command": "asc.review.resolveThread",
          "when": "commentController == asc.review && commentThread == asc.thread.open",
          "group": "inline@1"
        },
        {
          "command": "asc.review.reopenThread",
          "when": "commentController == asc.review && commentThread == asc.thread.resolved",
          "group": "inline@1"
        }
      ],
      "comments/commentThread/context": [
        {
          "command": "asc.review.createComment",
          "when": "commentController == asc.review",
          "group": "inline@1"
        }
      ]
