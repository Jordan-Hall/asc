+
+  # Post-merge: move green/master to the tested tip (SPEC 12.6). Deploys build only from green/*.
+  green:
+    needs: [typecheck-and-test, generated-artefacts, lint-conventions]
+    if: github.event_name == 'push' && github.ref == 'refs/heads/master'
+    runs-on: ubuntu-latest
+    timeout-minutes: 5
+    concurrency:
+      group: green-master
+      cancel-in-progress: false
+    steps:
+      - name: Install asc
+        uses: asc/actions/asc/setup@v1
+        with:
+          version: ${{ vars.ASC_VERSION }}
+          url: ${{ vars.ASC_URL }}
+          sha256: ${{ vars.ASC_SHA256 }}
+      - name: Move green/master
+        env:
+          ASC_TOKEN: ${{ github.token }}
+          ASC_REPO: ${{ github.repository }}
+          ASC_SERVER_URL: ${{ github.server_url }}
+          TIP: ${{ github.sha }}
+        run: |
+          set -euo pipefail
+          remote="$ASC_SERVER_URL/$ASC_REPO"
+          id="$(asc api Resolve --json "$(printf '{"revspecs":["%s"]}' "$TIP")" --remote "$remote" | jq -r '.ids[0]')"
+          asc api UpdateRefs --remote "$remote" --json             "$(jq -nc --arg id "$id" '{updates:[{name:"refs/heads/green/master",any:true,new:{changeset:$id}}],mode:"UPDATE_MODE_FAST_FORWARD"}')"
