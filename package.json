{
  "name": "asc-source-control",
  "private": true,
  "type": "module",
  "packageManager": "bun@1.4.4",
  "workspaces": [
    "packages/*",
    "web",
    "plugins/*"
  ],
  "scripts": {
    "lint": "oxlint --no-error-on-unmatched-pattern . && biome format .",
    "format": "biome format --write ."
  },
  "devDependencies": {
    "@biomejs/biome": "^2.6.2",
    "@bufbuild/buf": "^1.75.0",
    "oxlint": "^1.89.0",
    "turbo": "^2.11.10",
    "typescript": "^7.0.2"
  }
}
