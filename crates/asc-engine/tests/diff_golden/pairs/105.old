{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.org/schemas/form-ui-spec.schema.json",
  "title": "Form field UI spec",
  "type": "object",
  "required": [
    "type"
  ],
  "additionalProperties": false,
  "properties": {
    "type": {
      "enum": [
        "TextField",
        "NumberField",
        "BooleanField",
        "SelectField",
        "TextareaField",
        "DateField",
        "RadioField",
        "MultiSelectField",
        "CheckboxGroupField",
        "RatingField",
        "TimeField",
        "DateSplitField",
        "DisplayField",
        "CompositeField",
        "ComputedField",
        "ApiComputedField"
      ],
      "description": "A form-widget name from the @asc/ui form catalogue."
    },
    "props": {
      "type": "object",
      "additionalProperties": true
    }
  }
}
