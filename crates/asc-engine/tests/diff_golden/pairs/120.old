name: CI — Intelligence (typecheck + unit + rust)

# Fast, DB-free gate for the ingest → analysis → reporting → dashboards → public
# stack: typecheck + unit tests for insight-service / ingestion-service, the Rust
# analysis-pipeline tests, and a house-rule lint over the new migrations. The live
# browser e2e + image builds run in the separate (heavier) workflows.

on:
  push:
    branches: [master]
  pull_request:
    branches: ['**']
  workflow_dispatch:

jobs:
  typecheck-and-test:
    runs-on: ubuntu-latest
    timeout-minutes: 20
    steps:
      - name: Checkout
        uses: actions/checkout@11d5960a326750d5838078e36cf38b85af677262 # v4.4.0
        with:
          submodules: recursive

      - name: Setup Bun
        uses: oven-sh/setup-bun@0c5077e51419868618aeaa5fe8019c62421857d6 # v2.2.0
        with:
          bun-version: 1.2.22

      - name: Install dependencies
        run: bun install

      # Build the workspace dist packages the services import (ingest-core,
      # schema-meta-v2, json-render, …) so tsgo + bun test resolve them.
      - name: Build service dependency graphs
        run: bunx turbo run build --filter=insight-service... --filter=ingestion-service...

      - name: Typecheck insight-service
        run: bun run --cwd apps/insight-service check-types

      - name: Typecheck ingestion-service
        run: bun run --cwd apps/ingestion-service check-types

      - name: Unit tests — insight-service
        run: cd apps/insight-service && bun test

      # House-rule lint: the new migrations must use v3 SurrealQL forms only and
      # every DEFINE ACCESS must be OVERWRITE (re-runnable).
      - name: Migration house-rule lint (0206+)
        run: |
          cd packages/database-migrations/migrations
          fail=0
          # Strip SurrealQL comment lines (-- …) so banned forms mentioned in a
          # migration's explanatory header don't trip the lint — only real SQL counts.
          noncomment() { grep -rnE '.' "$@" | grep -vE ':[0-9]+:[[:space:]]*--'; }
          for pat in 'type::thing' 'type::is::' 'string::is::'; do
            if noncomment 02[0-9][0-9]_*.surql | grep -F "$pat"; then echo "::error::banned form '$pat' in a migration"; fail=1; fi
          done
          if noncomment 02[0-9][0-9]_*.surql | grep -iE 'define access' | grep -vi overwrite; then
            echo "::error::DEFINE ACCESS without OVERWRITE in a migration"; fail=1
          fi
          exit $fail

  rust:
    runs-on: ubuntu-latest
    timeout-minutes: 25
    env:
      CARGO_TERM_COLOR: always
    defaults:
      run:
        working-directory: rust/analysis-pipeline
    steps:
      - name: Checkout
        uses: actions/checkout@11d5960a326750d5838078e36cf38b85af677262 # v4.4.0
        with:
          submodules: recursive

      - name: Install Rust
        uses: dtolnay/rust-toolchain@4360b52568e2003a75bf9bc1d59f33a8e3fc893c # stable

      - name: Cargo check
        run: cargo check --workspace

      - name: Cargo test
        run: cargo test --workspace
