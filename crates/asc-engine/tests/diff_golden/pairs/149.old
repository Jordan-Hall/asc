{
  "name": "@asc/schema-dsl",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/types/index.d.ts",
      "import": "./dist/index.js"
    },
    "./schema-format": {
      "types": "./dist/types/schema-format/index.d.ts",
      "import": "./dist/schema-format/index.js"
    }
  },
  "sideEffects": false,
  "scripts": {
    "build": "rslib build",
    "build:grammar": "bun run scripts/generate-dsl-grammar.ts",
    "dev": "rslib build --watch",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "pretest": "rslib build",
    "test": "rstest run",
    "test:vitest": "rstest run",
    "docs:generate": "tsx scripts/generate-docs.ts && bun run docs:llms",
    "docs:llms": "bun run scripts/gen-llms-txt.ts",
    "docs:llms:check": "bun run scripts/gen-llms-txt.ts --check",
    "docs:check": "tsx scripts/generate-docs.ts --check && bun run docs:llms:check",
    "check": "bun run docs:check",
    "docs:dev": "rspress dev --port 5555",
    "docs:build": "rspress build",
    "docs:preview": "rspress preview --port 5555",
    "docs:reference": "bun run scripts/generate-reference.ts"
  },
  "devDependencies": {
    "@asc/ts-docs": "workspace:*",
    "@monaco-editor/react": "^4.6.0",
    "@repo/typescript-config": "workspace:*",
    "@rsbuild/plugin-node-polyfill": "^1.4.2",
    "@rslib/core": "^0.23.2",
    "@rstest/core": "^0.0.10",
    "@types/bun": "latest",
    "@types/react": "^19.2.0",
    "onnxruntime-web": "1.26.0-dev.20260416-b7804b056c",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "rspress": "^1.45.6",
    "tsx": "^4.19.2",
    "typescript": "7.0.2"
  },
  "dependencies": {
    "decimal.js": "^10.6.0"
  }
}
