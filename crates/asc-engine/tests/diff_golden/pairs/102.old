// Owned by @asc/form-schema; generates src/generated/form-widget-props.generated.ts
/**
 * Turn each form widget's real Zod props schema — `@asc/ui`'s
 * `componentCatalog` (`packages/ui/src/json-render/catalog.ts`) — into JSON
 * Schema via zod's own `z.toJSONSchema`, and write the result as committed,
 * generated data. `formUiSpecJsonSchema()` (`../src/json-schema.ts`) reads
 * that generated file at runtime — never `@asc/ui` itself — so
 * `@asc/form-schema` still carries no `@asc/ui` package/runtime
 * dependency. This script is the one place in this package allowed to
 * import `@asc/ui`, the same way `@asc/schema-core`'s
 * `json-render-catalog.test.ts` is the one place allowed to read
 * `@asc/ui` source off disk — both keep the coupling at generation/test
 * time, never at runtime.
 *
 * `binding`/`value`/`label`/`required`/`disabled`/`error` are stripped from
 * every widget's props before conversion: `compile-form-schema.ts`
 * (`@asc/ui`) injects those onto a field's RENDERED props from the field
 * itself and the live values, so they are never part of what a form author
 * writes in `ui.props`. `Composite` is excluded — its authored shape
 * (`primary`/`auxiliaries`) is a form-schema-only concept with no
 * counterpart in `@asc/ui`'s `CompositeProps` (which describes the
 * already-compiled, rendered props instead) — `json-schema.ts` builds its
 * schema by hand, reusing the other 17 widgets' generated schemas for its
 * `primary`/`auxiliaries` children.
 *
 * Imports `@asc/ui`'s catalog by RELATIVE SOURCE PATH, not the `@asc/ui`
 * package — a real package/devDependency edge here would create a cyclic
 * workspace dependency (`@asc/ui` already type-imports `@asc/form-schema`
 * for `FormFieldSchema`), which turbo's build graph rejects outright. A
 * relative import carries no package.json edge, needs no `@asc/ui` build
 * step, and — like `json-render-catalog.test.ts`'s off-disk read — only
 * ever runs at generation time, never shipped in this package's own build.
 *
 *   bun packages/form-schema/scripts/gen-widget-props.ts
 *   bun packages/form-schema/scripts/gen-widget-props.ts --check
 */
import { mkdirSync, readFileSync, writeFileSync } from 'node:fs';
import { join } from 'node:path';
import { z } from 'zod';
import { componentCatalog } from '../../ui/src/json-render/catalog';
import { FORM_ALLOWED_COMPONENTS } from '../src/types';

/** Injected onto a field's rendered props at compile time — never authored. */
const RUNTIME_INJECTED_PROPS = new Set(['binding', 'value', 'label', 'required', 'disabled', 'error']);

const OUT_PATH = join(import.meta.dir, '..', 'src', 'generated', 'form-widget-props.generated.ts');

/** `name`'s authorable props — its real catalog schema, minus the runtime-injected members — as JSON Schema. */
function authorablePropsJsonSchema(name: string): Record<string, unknown> {
  const entry = componentCatalog[name];
  if (!entry) throw new Error(`@asc/ui has no catalog entry for form widget '${name}'`);
  const shape = (entry.props as z.ZodObject).shape as Record<string, z.ZodType>;
  const authorable = Object.fromEntries(Object.entries(shape).filter(([key]) => !RUNTIME_INJECTED_PROPS.has(key)));
  const jsonSchema = z.toJSONSchema(z.object(authorable), { target: 'draft-2020-12', unrepresentable: 'any' }) as Record<string, unknown>;
  delete jsonSchema.$schema;
  return jsonSchema;
}

const widgetSchemas: Record<string, Record<string, unknown>> = {};
for (const name of FORM_ALLOWED_COMPONENTS) widgetSchemas[name] = authorablePropsJsonSchema(name);

const output = `/**
 * AUTO-GENERATED by \`bun run json-schema\` (scripts/gen-widget-props.ts) from
 * @asc/ui's real Zod props schemas — do not hand-edit. Each form widget's
 * exact authorable prop shape (its catalog props, minus the runtime-injected
 * members), converted to JSON Schema, so \`formUiSpecJsonSchema()\` can key a
 * \`oneOf\` branch per widget without this package depending on @asc/ui at
 * runtime. \`Composite\`'s entry describes @asc/ui's RENDERED props, not
 * what a form author writes — \`json-schema.ts\` does not use it, see
 * scripts/gen-widget-props.ts.
 */
import type { FormComponentName } from '../types';

export const FORM_WIDGET_PROPS_JSON_SCHEMA: Record<FormComponentName, Record<string, unknown>> = ${JSON.stringify(widgetSchemas, null, 2)} as Record<FormComponentName, Record<string, unknown>>;
`;

if (process.argv.includes('--check')) {
  let current = '';
  try {
    current = readFileSync(OUT_PATH, 'utf8');
  } catch {
    /* absent counts as stale */
  }
  if (current !== output) {
    console.error('src/generated/form-widget-props.generated.ts is stale — run: bun packages/form-schema/scripts/gen-widget-props.ts');
    process.exitCode = 1;
  } else {
    console.log('src/generated/form-widget-props.generated.ts current');
  }
} else {
  mkdirSync(join(import.meta.dir, '..', 'src', 'generated'), { recursive: true });
  writeFileSync(OUT_PATH, output, 'utf8');
  console.log('wrote src/generated/form-widget-props.generated.ts');
}
