[package]
name = "asc-bench-codeintel"
version = "0.1.0"
edition = "2024"
rust-version = "1.95"
license = "MIT OR Apache-2.0"
publish = false
description = "Code intelligence benchmarks against rg, git grep and Zoekt, and the gates of SPEC 23.9 (PLAN I27)"

# Standalone until the root workspace lists it (TODO(O05): add "bench/codeintel" to the members and
# switch the dependencies to `workspace = true`); the empty table keeps cargo from searching upwards.
[workspace]

[dependencies]
clap       = { version = "4.6.7", features = ["derive", "env"] }
serde      = { version = "1.0.229", features = ["derive"] }
serde_json = "1.0.154"
tempfile   = "3.27.0"
toml       = "1.1.8"

[lints.rust]
unsafe_code = "deny"
