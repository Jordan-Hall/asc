{
  "name": "@asc/ingest-core",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "sideEffects": false,
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "rslib build",
    "dev": "rslib build --watch --no-dts",
    "typecheck": "tsgo -p tsconfig.json --noEmit",
    "test": "bun test --timeout 30000"
  },
  "dependencies": {
    "@asc/database-types": "workspace:*",
    "@asc/form-schema": "workspace:*",
    "@asc/schema-core": "workspace:*"
  },
  "devDependencies": {
    "@repo/typescript-config": "workspace:*",
    "@rslib/core": "^0.23.2",
    "@rstest/core": "^0.0.10",
    "@typescript/native-preview": "latest",
    "typescript": "7.0.2"
  }
}
