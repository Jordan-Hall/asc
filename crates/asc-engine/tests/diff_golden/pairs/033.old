//! The ASC DSL's front end and its bytecode engine.
//!
//! Source text goes [`lexer`] to [`parser`] to [`ast`], and from there either
//! into this crate's own [`vm`] or - the path everything ships on - into
//! `dsl-ir`, which lowers it to an SSA instruction set, optimises it and
//! interprets that.
//!
//! What lives here is everything both paths need: the tokens, the syntax tree,
//! the value type, the number type, the builtin functions, the diagnostics, and
//! the modules a program can `use`.
//!
//! Two things a reader should know before anything else makes sense. Numbers
//! are decimal rather than binary floating point, so `0.1 + 0.2` is `0.3` and
//! the functions that cannot be exact are gathered in [`math`]. And the shapes
//! here mirror the TypeScript engine's deliberately: both read the same rules
//! and have to agree about what they mean, which a 203-case conformance corpus
//! checks.

/// The syntax tree a source parses into.
pub mod ast;
/// The syntax tree as JSON, for the editor across the binding boundary.
pub mod ast_json;
pub(crate) mod bytecode;
pub(crate) mod compiler;
/// Every higher-order call the language has.
///
/// They lower to their own instructions rather than to a builtin, so they are
/// absent from the builtin table: anything deciding whether a name is callable
/// has to ask here too, or it reports `map` as an unknown function.
pub use compiler::higher_order_names;
pub mod context;
/// Which fields an expression reads - what a form uses to know when to
/// re-evaluate a rule.
pub mod dependencies;
pub mod diagnostics;
pub mod error;
pub mod functions;
pub mod lexer;
/// The functions a decimal cannot compute exactly.
pub mod math;
/// The modules a program can `use`, and the grant that gates them.
pub mod modules;
/// The language's number type: decimal, not binary floating point.
pub mod num;
/// Tokens to a syntax tree, with error recovery for the editor.
pub mod parser;
/// The runtime value type.
pub mod value;
/// The bytecode compiler's interpreter.
pub mod vm;

pub use ast_json::{expr_json, parse_expr_json, parse_program_json, program_json, stmt_json};
pub use context::{EvalContext, ProgramContext};
pub use dependencies::{expression_dependencies, program_dependencies, program_source_dependencies, source_dependencies};
pub use diagnostics::{
    diagnose_expression, diagnose_expression_with, diagnose_program, diagnose_program_with,
    Diagnostic, KnownShape,
};
pub use error::DslError;
pub use parser::{parse_detailed, parse_program, parse_program_detailed, DetailedParseResult, ParseDiagnostic};
pub use value::Value;

/// Precision: 40 significant decimal digits.
/// Exceeds Decimal.js (34), Python decimal default (28), and R double (15.9).
pub const PRECISION: u64 = 40;
