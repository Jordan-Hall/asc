/**
 * The data engine's facade — the only module the pages, the chat dock and the
 * ai-service tools import.
 *
 * Every data-returning call takes a `Principal` as a REQUIRED argument, so a
 * caller that forgets the reader's scope fails to compile rather than leaking.
 * When this engine moves behind an HTTP boundary, this file becomes the client
 * and nothing above it changes.
 */
export { loadDataset, loadDatasetSync, listDatasetIds } from './dataset.js';
export { listReports, reportById, canOpen, offersOutlierAnalysis, isMembershipReport } from './catalogue.js';
export { runQuery, benchmarkQuery, matchesFilter, bucketDate } from './query.js';
export { evaluateMetric, listMetrics, metricById, loadMetricDefinitions, derivedColumns } from './metrics.js';
export { suggestSpec, suggestChartType } from './suggest.js';
export { parseQuestion, suggestedQuestions, isRanking } from './nl.js';
export { rankUnits, describeRanking } from './ranking.js';
export {
  NATIONAL,
  ANONYMOUS,
  BENCHMARK_GRAINS,
  describeScope,
  loadPersonas,
  personaById,
  scopeFilter,
} from './scope.js';
export { SUPPRESSION_THRESHOLD, SUPPRESSED_LABEL, suppressRows, rankable } from './suppress.js';
export {
  profileColumns,
  profileOf,
  dimensionColumns,
  measureColumns,
  labelFor,
  isPidKey,
} from './profile.js';
export { loadCodebook, decode, encode, isCoded, labelsFor } from './codebook.js';

export type { Persona } from './scope.js';
export type { EvaluateOptions } from './metrics.js';
export type { ChartKind, Intent, Spec, SpecElement, SuggestInput } from './suggest.js';
export type { ParsedQuestion, ParsedRanking, ParsedAsk } from './nl.js';
export type { CompositeRanking, UnitRanking, RankOptions } from './ranking.js';
export type {
  Aggregation,
  Codebook,
  ColumnProfile,
  ColumnRole,
  ColumnStats,
  Dataset,
  Filter,
  Measure,
  MetricDefinition,
  MetricResult,
  Principal,
  Query,
  QueryResult,
  QueryRow,
  Row,
  Scope,
  ScopeLevel,
  SemanticType,
  TimeGrain,
  Unit,
  Value,
  Visibility,
  ReportRef,
} from './types.js';
