import { AUTH_BASE_URL } from './auth-client';

export type BootstrapStatus = {
  hasAdmin: boolean;
  error?: string;
};

function apiUrl(path: string): string {
  const base = AUTH_BASE_URL.replace(/\/$/, '');
  return `${base}${path}`;
}

/**
 * Ask the auth service whether the platform already has an administrator.
 *
 * A failure here is retried rather than answered. `hasAdmin: false` is what
 * puts the first-owner setup flow on screen, so treating one dropped connection
 * as "there is no admin" offers account creation to whoever happens to reload
 * while the auth service is restarting.
 */
export async function fetchBootstrapStatus(): Promise<BootstrapStatus> {
  const attempts = 3;
  let lastError = 'UNKNOWN_ERROR';

  for (let attempt = 0; attempt < attempts; attempt++) {
    if (attempt > 0) {
      await new Promise((resolve) => setTimeout(resolve, 500 * attempt));
    }

    try {
      const res = await fetch(apiUrl('/api/bootstrap/status'), {
        credentials: 'include',
        headers: { 'Accept': 'application/json' },
      });
      if (!res.ok) {
        lastError = `HTTP_${res.status}`;
        console.warn(`[bootstrap] Status request failed (${lastError})`);
        // A served error is an answer, not a transport failure; do not retry it.
        return { hasAdmin: false, error: lastError };
      }
      const data = await res.json() as Partial<BootstrapStatus>;
      return {
        hasAdmin: Boolean(data?.hasAdmin),
        error: data?.error,
      };
    } catch (err) {
      lastError = err instanceof Error ? err.message : 'UNKNOWN_ERROR';
      console.warn(`[bootstrap] Status request attempt ${attempt + 1} failed`, err);
    }
  }

  console.error(`[bootstrap] Failed to fetch status after ${attempts} attempts`);
  return { hasAdmin: false, error: lastError };
}