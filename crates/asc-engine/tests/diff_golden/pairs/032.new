//! What an expression is evaluated against.
//!
//! Three things, and the difference matters to what a rule can see: `value` is
//! the record being evaluated, `root` is the whole it sits inside - so a rule
//! on one answer can reach the rest of the form - and `ctx` is anything further
//! the host chose to expose.
//!
//! For a rule evaluated on its own, `value` and `root` are the same record.

use crate::value::Value;

/// Context passed to every evaluation.
#[derive(Debug, Clone)]
pub struct EvalContext {
    /// The primary record being evaluated.
    pub value: Value,
    /// The root collection (e.g. the full dataset).
    pub root: Value,
    /// Additional context object (optional extra data).
    pub ctx: Option<Value>,
    /// Named inputs the host passes in, read with `sys.input("name")`: an
    /// object of any values a program is given, beside the three above. A
    /// program that names its inputs itself - `let record = sys.input("record")`
    /// - needs none of `value`, `root` or `ctx` to mean anything.
    pub inputs: Option<Value>,
}

impl EvalContext {
    /// A context where the record is also the root - the ordinary case for a
    /// rule evaluated against one record.
    pub fn new(value: Value) -> Self {
        Self {
            value: value.clone(),
            root: value,
            ctx: None,
            inputs: None,
        }
    }

    /// A context where the record sits inside a larger one, so an expression
    /// can reach back out to the whole.
    pub fn with_root(value: Value, root: Value) -> Self {
        Self {
            value,
            root,
            ctx: None,
            inputs: None,
        }
    }

    /// As [`with_root`](Self::with_root), with a further object of data the
    /// host wants the expression to see.
    pub fn with_ctx(value: Value, root: Value, ctx: Value) -> Self {
        Self {
            value,
            root,
            ctx: Some(ctx),
            inputs: None,
        }
    }
}

impl EvalContext {
    /// This context with named inputs, for `sys.input("name")`.
    pub fn with_inputs(mut self, inputs: Value) -> Self {
        self.inputs = Some(inputs);
        self
    }
}

/// Context for program-level execution (multi-statement scripts).
#[derive(Debug, Clone)]
pub struct ProgramContext {
    /// The base expression evaluation context.
    pub base: EvalContext,
    /// Accumulated output lines from `print` statements.
    pub output: Vec<Value>,
    /// Global variable bindings within the program.
    pub env: std::collections::HashMap<String, Value>,
}

impl ProgramContext {
    /// A program context over an expression context, with nothing printed
    /// and nothing bound yet.
    pub fn new(base: EvalContext) -> Self {
        Self {
            base,
            output: Vec::new(),
            env: std::collections::HashMap::new(),
        }
    }
}
