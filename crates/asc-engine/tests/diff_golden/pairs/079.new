/**
 * Walking a rule that came out wrong.
 *
 * The debugger runs the real engine over the real record: anything that worked
 * out what an expression "would" do would be a second evaluator, and one that
 * disagreed with the first is worse than no debugger - it would explain
 * confidently why a rule did something it did not do.
 */
import { expect, test } from '@rstest/core';
import { createExpressionDebugger } from './expression-debugger.js';

const RULE = 'root.age >= 18 and root.age <= 65';

function open(source: string, root: unknown) {
  const { element, run } = createExpressionDebugger();
  document.body.appendChild(element);
  run({ source, value: null, root });
  return element;
}

const textOf = (el: HTMLElement, selector: string): string =>
  el.querySelector(selector)?.textContent ?? '';

/** A control by what it says it does, rather than by where it sits. */
function press(panel: HTMLElement, title: string): HTMLButtonElement {
  // SAFETY: the selector names a `<button>`, so a match is one.
  const found = panel.querySelector(
    `button[title="${title}"]`,
  ) as HTMLButtonElement | null;
  if (!found) throw new Error(`no control titled ${title}`);
  return found;
}

test('the first step highlights the first comparison, not the whole rule', () => {
  const panel = open(RULE, { age: 74 });
  expect(textOf(panel, '.dsl-debugger-covered')).toBe('root.age >= 18');
});

test('stepping on highlights the comparison that decided it', () => {
  const panel = open(RULE, { age: 74 });
  // 74 is over 18 and over 65: the second comparison is why this is false, and
  // finding that is the whole reason for opening a debugger.
  press(panel, 'Next step').click();
  expect(textOf(panel, '.dsl-debugger-covered')).toBe('root.age <= 65');
  expect(textOf(panel, '.dsl-debugger-value')).toContain('false');
});

test('the first comparison is shown passing', () => {
  const panel = open(RULE, { age: 74 });
  expect(textOf(panel, '.dsl-debugger-value')).toContain('true');
});

test('the panel says where in the run the reader is', () => {
  const panel = open(RULE, { age: 40 });
  expect(textOf(panel, '.dsl-debugger-status')).toContain('Step 1 of');
});

test('the whole answer is reported beside the steps', () => {
  const panel = open(RULE, { age: 40 });
  expect(textOf(panel, '.dsl-debugger-status')).toContain(
    'the whole expression came to true',
  );
});

test('stepping stops at the ends rather than wrapping', () => {
  const panel = open(RULE, { age: 40 });
  expect(press(panel, 'First step').disabled).toBe(true);
  expect(press(panel, 'Previous step').disabled).toBe(true);
  press(panel, 'Last step').click();
  expect(press(panel, 'Next step').disabled).toBe(true);
});

test('the source is put in as text, never as markup', () => {
  // The source is somebody's rule. Building markup out of it would be one
  // injection away from a problem.
  const panel = open("root.name == '<img src=x onerror=alert(1)>'", {
    name: 'x',
  });
  expect(panel.querySelector('img')).toBeNull();
  expect(panel.textContent).toContain('<img src=x onerror=alert(1)>');
});

test('an expression that will not compile says so instead of showing nothing', () => {
  const panel = open('root.age >=', { age: 40 });
  expect(textOf(panel, '.dsl-debugger-status')).not.toBe('');
  expect(textOf(panel, '.dsl-debugger-status')).not.toContain('Step 1 of');
});

/**
 * Stopping where the reader points.
 *
 * `Continue` ran only to somewhere the ENGINE marked, so a reader asking about
 * one comparison in a long rule pressed Next until they reached it. They set
 * the stop themselves now, on the source, the way they would in a debugger
 * they already use.
 */
test('clicking the rule marks where to stop, and running on goes there', () => {
  const panel = open(RULE, { age: 74 });
  /*
    The second comparison, clicked. Each step the trace covers is drawn as its
    own element carrying the offset it starts at, so a reader points at the
    part of their rule they are asking about and this points at the same thing.
  */
  const spans = [
    ...panel.querySelectorAll<HTMLElement>('[data-offset]'),
  ];
  const second = spans.find((span) => span.textContent === 'root.age <= 65');
  if (!second) throw new Error('the rule was not drawn as its own spans');
  second.dispatchEvent(new MouseEvent('click', { bubbles: true }));

  expect(panel.querySelector('.dsl-debugger-breakpoint')?.textContent).toBe(
    'root.age <= 65',
  );

  press(panel, 'Run on to the next breakpoint or stopping point').click();
  expect(textOf(panel, '.dsl-debugger-covered')).toBe('root.age <= 65');
});

test('clicking it again clears the breakpoint', () => {
  const panel = open(RULE, { age: 74 });
  const click = () => {
    const span = [...panel.querySelectorAll<HTMLElement>('[data-offset]')].find(
      (s) => s.textContent === 'root.age <= 65',
    );
    span?.dispatchEvent(new MouseEvent('click', { bubbles: true }));
  };
  click();
  click();
  expect(panel.querySelector('.dsl-debugger-breakpoint')).toBeNull();
});

test('a reader can run back to where they stopped', () => {
  const panel = open(RULE, { age: 74 });
  press(panel, 'Last step').click();
  press(panel, 'Run back to the previous breakpoint or stopping point').click();
  // With nothing marked, running back reaches the beginning rather than
  // sitting where it was.
  expect(textOf(panel, '.dsl-debugger-covered')).toBe('root.age >= 18');
});
