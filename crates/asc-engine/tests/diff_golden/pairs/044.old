import {
  isPlatformAdmin,
  normalizeWorkspaceRole,
} from '@asc/better-auth-permissions';
import type { DBAdapter } from 'better-auth';
import type { UserTeamContext } from './adapter.js';

export async function isSystemOrOrgAdmin(params: {
  adapter: DBAdapter;
  userId: string;
  userRole?: string | null;
  organizationId: string | null;
  teamContext?: UserTeamContext;
}): Promise<boolean> {
  const { adapter, userId, userRole, organizationId, teamContext } = params;

  // Check if user is a platform admin (owner or admin system role)
  if (isPlatformAdmin(userRole)) {
    return true;
  }

  if (!organizationId) {
    return false;
  }

  const orgMember = (await adapter.findOne({
    model: 'member',
    where: [
      { field: 'userId', value: userId },
      { field: 'organizationId', value: organizationId },
    ],
  })) as { role: string } | null;

  // member.role is comma-separated for multi-role members (same convention
  // as workspaceMember/teamMember), so a direct `=== 'owner'` comparison
  // silently denies a member whose role string is e.g. "owner,auditor".
  const orgMemberRoles = normalizeWorkspaceRole(orgMember?.role);
  if (orgMemberRoles.includes('owner') || orgMemberRoles.includes('admin')) {
    return true;
  }

  const ctx = teamContext ?? (await getTeamContext(adapter, userId));
  const orgTeams = ctx.teamsByOrg.get(organizationId);

  return orgTeams !== undefined && orgTeams.length > 0;
}

export async function getTeamContext(
  adapter: DBAdapter,
  userId: string,
): Promise<UserTeamContext> {
  const teamMemberships = (await adapter.findMany({
    model: 'teamMember',
    where: [{ field: 'userId', value: userId }],
  })) as Array<{ teamId: string; userId: string; role?: string }>;

  const teamIds = teamMemberships.map((tm) => tm.teamId);

  if (teamIds.length === 0) {
    return {
      teamMemberships,
      teamIds,
      teams: [],
      teamsByOrg: new Map(),
    };
  }

  const teams = (await adapter.findMany({
    model: 'team',
    where: [{ field: 'id', value: teamIds, operator: 'in' }],
  })) as Array<{ id: string; organizationId: string }>;

  const teamsByOrg = new Map<
    string,
    Array<{ id: string; organizationId: string }>
  >();
  for (const team of teams) {
    const existing = teamsByOrg.get(team.organizationId) || [];
    existing.push(team);
    teamsByOrg.set(team.organizationId, existing);
  }

  return { teamMemberships, teamIds, teams, teamsByOrg };
}

export async function hasOrganizationAccessViaTeam(params: {
  adapter: DBAdapter;
  userId: string;
  organizationId: string;
  teamContext?: UserTeamContext;
}): Promise<boolean> {
  const { adapter, userId, organizationId, teamContext } = params;

  const ctx = teamContext ?? (await getTeamContext(adapter, userId));
  const orgTeams = ctx.teamsByOrg.get(organizationId);

  return orgTeams !== undefined && orgTeams.length > 0;
}
