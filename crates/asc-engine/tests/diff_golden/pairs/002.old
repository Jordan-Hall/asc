{
  "name": "@asc/private",
  "private": true,
  "workspaces": [
    "packages/*",
    "packages/*/*",
    "packages/dsl/core/rust",
    "packages/dsl/core/rust/npm/*",
    "packages/soma/models/*",
    "packages/soma/sdk/ts/*",
    "!packages/soma/sdk/package.json",
    "apps/*",
    "apps/*/*",
    "apps/*/*/*",
    "plugins/*"
  ],
  "scripts": {
    "artefacts": "bun scripts/artefacts.ts status",
    "artefacts:pull": "bun scripts/artefacts.ts pull",
    "artefacts:push": "bun scripts/artefacts.ts push",
    "audit:graph": "bun packages/repo-audit/src/cli.ts --graphify",
    "audit:repo": "bun packages/repo-audit/src/cli.ts",
    "audit:repo:ai": "bun packages/repo-audit/src/cli.ts --graphify --review=ollama",
    "audit:repo:ci": "bun packages/repo-audit/src/cli.ts --fail-on=error",
    "repair:bins": "bun scripts/repair-bin-shims.ts",
    "build": "turbo run build",
    "check": "oxlint && oxfmt --check",
    "check:env": "bun scripts/check-env-example.ts",
    "check:exports": "bun scripts/check-exports.ts",
    "check:docs": "bun scripts/check-docs.ts",
    "check:fix": "oxlint --fix && oxfmt",
    "check:layout": "bun scripts/check-layout.ts",
    "check:schemas": "bun scripts/check-schema-instances.ts",
    "check:userdb": "bun scripts/check-user-db.ts",
    "clean": "bun -e \"import{rmSync}from'node:fs';import{Glob}from'bun';for(const d of new Glob('{apps,packages,plugins}/**/dist').scanSync({onlyFiles:false})){if(d.includes('node_modules'))continue;rmSync(d,{recursive:true,force:true});console.log('removed '+d)}\"",
    "comments:prune": "bun scripts/prune-comments.ts",
    "deploy:affected": "bun scripts/deploy-affected.ts",
    "deploy:delta": "bun ops/delta/deploy-estate.ts",
    "dev": "turbo run dev --continue=dependencies-successful --ui=stream",
    "format": "oxfmt",
    "lint": "oxlint",
    "postinstall": "bun scripts/artefacts.ts postinstall || true",
    "preview": "turbo run preview",
    "skills:check": "bun scripts/check-skills-sync.ts",
    "skills:sync": "bun scripts/check-skills-sync.ts --write",
    "test": "turbo run test",
    "lint:fix": "oxlint --fix",
    "format:check": "oxfmt --check",
    "lint:biome": "biome lint .",
    "format:biome": "biome check --write .",
    "i18n:check": "bun scripts/i18n-check.ts",
    "i18n:missing": "bun scripts/i18n-missing-keys.ts",
    "i18n:audit": "bun scripts/i18n-audit.ts --summary packages/ui/src apps/core/auth-ui apps/core/auth-mfe apps/core/ingest-mfe apps/delta/audits apps/delta/schema-designer-v2 apps/pulse/shell apps/pulse/dashboards-mfe apps/pulse/reporting-mfe apps/pulse/analytics-ui apps/business/support-mfe apps/business/admin-ui apps/delta/application-list --max 0"
  },
  "dependencies": {
    "@rslib/core": "^0.23.2",
    "commander": "^15.0.0",
    "papaparse": "^5.7.0",
    "quill": "^2.0.3"
  },
  "devDependencies": {
    "@modelcontextprotocol/sdk": "^1.29.0",
    "@oxlint/plugins": "1.80.0",
    "@types/bun": "latest",
    "@types/papaparse": "^5.5.2",
    "@types/quill": "^2.0.14",
    "ajv": "^8.20.0",
    "oxfmt": "^0.65.0",
    "oxlint": "^1.80.0",
    "prettier": "^3.8.3",
    "turbo": "^2.10.11",
    "typescript": "7.0.2"
  },
  "overrides": {
    "@better-auth/oauth-provider": "1.7.0-rc.6",
    "@hono/zod-validator": "^0.8.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "better-auth": "1.7.0-rc.6",
    "error-ex": "1.3.2",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "zod": "^4"
  },
  "engines": {
    "bun": ">=1.2.22",
    "node": ">=18"
  },
  "packageManager": "bun@1.2.22",
  "patchedDependencies": {
    "compromise@14.14.5": "patches/compromise@14.14.5.patch"
  },
  "trustedDependencies": [
    "@biomejs/biome",
    "@parcel/watcher",
    "@swc/core",
    "@tailwindcss/oxide",
    "core-js",
    "core-js-pure"
  ]
}
