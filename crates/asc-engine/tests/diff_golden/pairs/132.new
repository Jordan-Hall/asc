import { defineComponent } from '@asc/router';
import { Signal } from '@asc/signal';
import { getPlacement } from '@asc/plugin-placements';
import { createPlacementHost, defineSlot } from '@asc/plugin-runtime/placements';
import { AUDIT_SECTION } from '../plugin-host/placements';
import { reportError } from '../plugin-host/runtime';

let declared = false;

/***
 * Declare the section placement once.
 *
 * The mount node below existed and nothing declared it, so it was decorative: a plugin
 * naming `audit.section` had nowhere to go however far it got through publish, review,
 * entitlement and enablement. The ceiling comes from the catalogue rather than being
 * restated here, so a plugin approved against the published ceiling cannot be refused by
 * a host quietly offering less.
 *
 * The prefix is `routes`, and the mirror carries the route parameters. The catalogue's
 * ceiling also names entry and schema fields, for a host that has entries to list; this
 * page has none, so those paths simply match nothing. A grant is a ceiling, not a promise
 * that every host fills it.
 */
function declareOnce(): void {
	if (declared) return;
	const catalogue = getPlacement(AUDIT_SECTION);
	if (catalogue) {
		defineSlot(AUDIT_SECTION, {
			capabilities: catalogue.capabilityCeiling,
			statePathPrefix: 'routes',
		});
		declared = true;
	}
}

/***
 * The landing page for the reserved plugin route prefix.
 *
 * A plugin that ships a routed section registers its own routes underneath `plugins/`,
 * so in normal use a visitor lands on one of those rather than here. This page exists
 * for the case where the prefix itself is opened: either nothing is enabled, or a
 * plugin route was withdrawn under the visitor's feet by a kill switch and the router
 * sent them back to a real page.
 *
 * It also carries the route-area mount node, so a plugin that wants to contribute to
 * the section index rather than a route of its own has somewhere to render.
 */
export const PluginSectionComponent = defineComponent(() => {
	const container = document.createElement('div');
	container.className = 'p-6 flex flex-col gap-6';

	const heading = document.createElement('h1');
	heading.className = 'text-xl font-semibold text-[rgb(var(--color-text-base))]';
	heading.textContent = 'Plugins';
	container.appendChild(heading);

	const description = document.createElement('p');
	description.className = 'text-sm text-[rgb(var(--color-text-muted))] max-w-prose';
	description.textContent =
		'Sections added by plugins appear here once an administrator has enabled them for this workspace.';
	container.appendChild(description);

	const mount = document.createElement('div');
	mount.className = 'flex flex-col gap-6';
	mount.dataset.pluginPlacement = AUDIT_SECTION;
	container.appendChild(mount);

	declareOnce();
	const host = createPlacementHost(AUDIT_SECTION, {
		container: mount,
		formState: new Signal.State<Record<string, unknown>>({ params: {} }),
		// This page owns no entry, so there is nothing here a plugin could write to. The
		// ceiling allows a metadata sub-tree for hosts that do; refusing by name here is the
		// host's half of that, and says so rather than failing silently.
		writeField: (name) => {
			throw new Error(`The plugin section index holds no entry, so "${name}" cannot be written here.`);
		},
		data: {},
		reportError,
	});

	// The router sweeps `_cleanup` on the container it replaces.
	(container as unknown as { _cleanup?: () => void })._cleanup = () => {
		host.unmountAll();
		host.dispose();
	};

	return container;
});
