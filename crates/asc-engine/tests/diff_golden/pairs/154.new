import { describe, it, expect } from "bun:test";
import { ensureUserExistsAndAssignRole } from "../src/admin/system-admin-helpers.js";

describe("ensureUserExistsAndAssignRole", () => {
  it("creates through the admin client and then sets the role", async () => {
    // The shapes here are better-auth's own admin client: createUser to make the account
    // and setRole to grant it. An earlier version of this test mocked admin.users.create
    // and admin.users.update, which the helper has never called — so it asserted an API
    // that does not exist and could not have passed.
    const calls: any[] = [];
    const authClient = {
      admin: {
        createUser: async (payload: any) => { calls.push(["createUser", payload]); return { data: { id: "u_123" } }; },
        setRole: async ({ userId, role }: any) => { calls.push(["setRole", userId, role]); return { ok: true }; },
      }
    };
    const id = await ensureUserExistsAndAssignRole({ authClient, email: "a@b.c", name: "Alice", desiredId: "u_123", role: "admin" });
    expect(id).toBe("u_123");
    expect(calls[0][0]).toBe("createUser");
    expect(calls[1]).toEqual(["setRole", "u_123", "admin"]);
  });

  it("reads the new id from an unwrapped response as well as a data-wrapped one", async () => {
    const calls: any[] = [];
    const authClient = {
      admin: {
        createUser: async (payload: any) => { calls.push(["createUser", payload]); return { id: "u_999" }; },
        updateUser: async ({ id, role }: any) => { calls.push(["updateUser", id, role]); return { ok: true }; },
      }
    };
    const id = await ensureUserExistsAndAssignRole({ authClient, email: "x@y.z", role: "owner" });
    expect(id).toBe("u_999");
    expect(calls[0][0]).toBe("createUser");
  });

  it("throws for invalid email", async () => {
    const authClient = { admin: {} } as any;
    let threw = false;
    try {
      await ensureUserExistsAndAssignRole({ authClient, email: "not-an-email", role: "admin" });
    } catch {
      threw = true;
    }
    expect(threw).toBe(true);
  });
});
