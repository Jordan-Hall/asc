[workspace]
resolver = "2"
members = [
  "crates/dsl-core",
  "crates/dsl-ir",
  "crates/dsl-cranelift",
  "crates/dsl-wasm",
  "crates/dsl-napi",
  "crates/dsl-cli",
  "crates/dsl-grammar",
]

[workspace.package]
version = "0.1.0"
edition = "2021"
license = "MIT"

[workspace.dependencies]
dsl-core = { path = "crates/dsl-core", default-features = false }
dsl-ir = { path = "crates/dsl-ir", default-features = false }
serde = { version = "1.0", features = ["derive", "rc"] }
serde_json = { version = "1.0" }
bigdecimal = { version = "0.4", features = ["serde"] }
num-bigint = { version = "0.4" }
num-traits = { version = "0.2" }
indexmap = { version = "2", features = ["serde"] }
chrono = { version = "0.4", features = ["serde"] }
regex = { version = "1" }
sha2 = { version = "0.10" }
md-5 = { version = "0.10" }
hex = { version = "0.4" }
thiserror = { version = "1.0" }
once_cell = { version = "1.0" }
rayon = { version = "1.10" }
wasm-bindgen-rayon = { version = "1.2" }
clap = { version = "4", features = ["derive"] }
anyhow = { version = "1" }
csv = { version = "1.3" }
# ureq, not reqwest. The `http` module is blocking by definition - the DSL has
# no await - and reqwest's blocking client is a thin wrapper that starts an
# async executor per call to block on it. That executor and its stack were 98 of
# this workspace's 139 dependencies, inside an expression compiler.
#
# rustls rather than a system TLS library, for the same reason as before: an
# addon linked against the host's OpenSSL only loads where that exact OpenSSL
# is, and musl has none to link against at all.
ureq = { version = "3.4" }
http = { version = "1" }

[profile.release]
opt-level = 3
lto = "thin"
codegen-units = 1
strip = "symbols"

# What the shipped artefacts are built with.
#
# Fat LTO takes the addon from 5,915,648 to 5,670,400 bytes, a little over 4%,
# and costs about 60% more build time - 37s against 60s from clean. That is a
# fair trade for a binary compiled once in CI and then loaded by everyone, and a
# poor one for the local edit-build-test loop, which is why `release` keeps thin
# LTO and only `build:napi` selects this. The WASM build cannot: wasm-pack
# passes `--release` itself and rejects a custom profile beside it, and the
# size that matters there is the one wasm-opt produces anyway.
#
# Throughput is NOT the reason. The handle benchmarks move about 2-5%, and the
# batch benchmark swings from 906k to 1.23M evals/sec between runs of the same
# binary, so anything that path appears to show is noise.
[profile.dist]
inherits = "release"
lto = "fat"
