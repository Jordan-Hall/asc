# Go stubs for the Forgejo fork. Rust code is generated by asc-rpc's build.rs, not buf.
version: v2
# The Go import path belongs to the consuming fork, not to the schema: set it here, not in the .proto files.
managed:
  enabled: true
  override:
    - file_option: go_package
      value: forgejo.org/modules/ascproto/ascv1
plugins:
  - remote: buf.build/protocolbuffers/go
    out: gen/go
    opt: paths=source_relative
  - remote: buf.build/grpc/go
    out: gen/go
    opt: paths=source_relative
