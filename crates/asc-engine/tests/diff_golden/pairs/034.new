import 'dotenv/config';
import { defineConfig } from '@rsbuild/core';
import { pluginPWA } from 'rsbuild-plugin-pwa';

export default defineConfig({
  plugins: [
    pluginPWA({
      htmlTags: {
        themeColor: true,
        appleTouchIcon: { href: '/icons/nela-192.png' },
        icon: { href: '/icons/nela-192.png', type: 'image/png' },
      },
      webAppManifest: {
        content: {
          name: 'NELA Risk Calculator',
          short_name: 'NELA Risk',
          description:
            'Estimate the risk of death within 30 days of emergency abdominal surgery. Use the result alongside clinical judgement and discussion with the patient and their family. The calculator works offline after your first visit.',
          screenshots: [
            {
              src: '/screenshots/disclaimer-mobile.png',
              sizes: '390x844',
              type: 'image/png',
              form_factor: 'narrow',
              label: 'Review the NELA disclaimer',
            },
            {
              src: '/screenshots/assessment-mobile.png',
              sizes: '390x844',
              type: 'image/png',
              form_factor: 'narrow',
              label: 'Complete the risk assessment',
            },
          ],
          id: '/',
          start_url: '/',
          scope: '/',
          display: 'standalone',
          background_color: '#ffffff',
          theme_color: '#ffffff',
          icons: [
            {
              src: '/icons/nela-192.png',
              sizes: '192x192',
              type: 'image/png',
              purpose: 'any maskable',
            },
            {
              src: '/icons/nela-512.png',
              sizes: '512x512',
              type: 'image/png',
              purpose: 'any maskable',
            },
          ],
        },
      },
      sw: {
        mode: 'generateSw',
        include: ['**/*'],
        workboxOptions: {
          maximumFileSizeToCacheInBytes: 5 * 1024 * 1024,
          navigateFallback: '/index.html',
        },
      },
    }),
  ],
  source: {
    entry: {
      index: './src/client.ts',
    },

    define: {
      'import.meta.env.NODE_ENV': JSON.stringify(
        import.meta.env.NODE_ENV || 'production',
      ),
      // Read at runtime by src/analytics.ts; without it here the flag is
      // undefined in the bundle and the switch has nothing to read.
      'import.meta.env.OPENPANEL_ENABLED': JSON.stringify(
        import.meta.env.OPENPANEL_ENABLED ?? null,
      ),
      'import.meta.env.OPENPANEL_CLIENT_ID': JSON.stringify(
        import.meta.env.OPENPANEL_CLIENT_ID ?? null,
      ),
      'import.meta.env.OPENPANEL_API_URL': JSON.stringify(
        import.meta.env.OPENPANEL_API_URL ?? null,
      ),
    },
  },
  html: {
    template: './index.html',
  },
  /*
   * The port is the app's address, not a preference. Without `strictPort`
   * rsbuild answers a taken port by quietly moving to the next free one, and
   * whatever tries to reach this app at its own address gets whichever app
   * moved in - which is how the e2e suite came to measure the sign-in page and
   * report it as the risk calculator.
   */
  server: {
    port: parseInt(import.meta.env.NELA_RISK_CALCULATOR_APP_PORT || '5178'),
    strictPort: true,
    open: true,
    headers: {
      'Access-Control-Allow-Origin': '*',
    },
    historyApiFallback: true,

    publicDir: {
      name: 'public',
      watch: true,
      copyOnBuild: true,
    },
  },
  output: {
    assetPrefix: '/',

    cleanDistPath: true,
  },
});
