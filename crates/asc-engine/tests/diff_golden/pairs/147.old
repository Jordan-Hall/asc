{
  "name": "auth",
  "scripts": {
    "dev": "bun run --hot  --inspect src/index.ts",
    "start": "bun run dist/index.js",
    "build": "bun build src/index.ts --outdir ./dist  --target bun",
    "check-types": "tsc --noEmit",
    "generate:surql": "npx -y auth@1.7.0-rc.6 generate",
    "generate:migration": "bun run scripts/generate-migration.ts"
  },
  "dependencies": {
    "@asc/better-auth-admin-access": "workspace:*",
    "@asc/better-auth-permissions": "workspace:*",
    "@asc/database-migrations": "workspace:*",
    "@asc/better-auth-external-structure": "workspace:*",
    "@asc/better-auth-organization-archive": "workspace:*",
    "@asc/better-auth-workspace": "workspace:*",
    "better-auth": "1.7.0-rc.6",
    "@better-auth/passkey": "1.7.0-rc.6",
    "dotenv": "^17.2.3",
    "hono": "^4.10.6",
    "nodemailer": "^7.0.9",
    "surrealdb": "^2.0.3"
  },
  "devDependencies": {
    "@repo/eslint-config": "workspace:*",
    "@repo/typescript-config": "workspace:*",
    "@types/bun": "latest",
    "better-call": "^1.3.7",
    "eslint": "^9.34.0",
    "typescript": "7.0.2"
  },
  "peerDependencies": {
    "@simplewebauthn/server": "^13.2.2",
    "better-call": "^1.3.7"
  }
}
