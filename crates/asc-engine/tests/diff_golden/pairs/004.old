[package]
name = "asc"
version = "0.1.0"
edition.workspace = true
rust-version.workspace = true
license.workspace = true
publish = false

[lints]
workspace = true

[features]
default = ["serve", "vfs-projfs", "vfs-fuse", "git-compat", "git-ssh", "http3", "forgejo"]
# The git smart-HTTP layer (SPEC 25); forwards to `asc-git` and, when `serve` is on, `asc-serve`.
git-compat = ["asc-git/git-compat", "asc-serve?/git-compat"]
# SSH public keys in the token store and the SSH listener (SPEC 25.11); the SSH library lives in
# `asc-serve` only, so this adds `asc serve ssh-key` and nothing to `asc-git`.
git-ssh = ["git-compat", "asc-serve?/git-ssh"]
serve = ["dep:asc-serve"]
# The optional Forgejo adapter of `asc serve` (hooks, `provider = "forgejo"`, push webhook).
forgejo = ["asc-serve?/forgejo"]
# HTTP/3 (U89b): the HTTPS client upgrades to h3 after `Alt-Svc`, and `asc serve` listens for QUIC
# when `[tls]` and `http3_port` are set. Off, no QUIC crate is built.
http3 = ["asc-rpc/http3", "asc-serve?/http3"]
vfs-projfs = ["dep:asc-vfs", "asc-vfs/projfs"]
vfs-fuse = ["dep:asc-vfs", "asc-vfs/fuse"]

[dependencies]
asc-core = { workspace = true }
asc-store = { workspace = true }
asc-engine = { workspace = true }
asc-graph = { workspace = true }
asc-git = { workspace = true }
asc-rpc = { workspace = true }
asc-mcp = { workspace = true }
asc-wc = { workspace = true }
asc-ci = { workspace = true }
asc-codeintel = { workspace = true }
asc-state = { workspace = true }
asc-serve = { workspace = true, optional = true }
anyhow = { workspace = true }
bstr = { workspace = true }
async-trait = { workspace = true }
bytes = { workspace = true }
clap = { workspace = true }
futures = { workspace = true }
gix = { workspace = true }
gix-attributes = { workspace = true }
gix-config = { workspace = true }
gix-date = { workspace = true }
gix-sec = { workspace = true }
prost-reflect = { workspace = true }
regex = { workspace = true }
serde_json = { workspace = true }
thiserror = { workspace = true }
tokio = { workspace = true }
uuid = { workspace = true }
linkme = { workspace = true }
automod = { workspace = true }
serde = { workspace = true }
sqlx = { workspace = true }
tonic = { workspace = true }
minisign-verify = { workspace = true }
sha2 = { workspace = true }
reqwest = { workspace = true }
http = { workspace = true }
object_store = { workspace = true }
url = { workspace = true }
zip = { workspace = true }
roaring = { workspace = true }
tantivy = { workspace = true }
blake3 = { workspace = true }

[dev-dependencies]
tempfile = { workspace = true }
similar = { workspace = true }
toml = { workspace = true }
axum = { workspace = true }
rustls = { workspace = true }
rcgen = { version = "0.14.10", default-features = false, features = ["crypto", "ring", "pem"] }

# vfs-projfs is Windows-only, vfs-fuse is Linux-only; the dep is optional on both.
[target.'cfg(windows)'.dependencies]
asc-vfs = { workspace = true, optional = true }
# Ownership check of the safe.directory gate (cli/safe_dir.rs).
windows-sys = { workspace = true }

[target.'cfg(target_os = "linux")'.dependencies]
asc-vfs = { workspace = true, optional = true }

[target.'cfg(unix)'.dependencies]
# Effective uid for the safe.directory gate (cli/safe_dir.rs).
rustix = { workspace = true, features = ["process", "stdio"] }
