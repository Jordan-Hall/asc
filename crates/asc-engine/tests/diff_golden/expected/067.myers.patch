diff --git a/file b/file
index 78388c2..af47cdc 100644
--- a/file
+++ b/file
@@ -24,3 +24,22 @@ test('rewrites Domino paths inside scripts and css urls', () => {
     rewriteText(`a{background:url(/domcfg.nsf/i.png)}`, host, 'text/css'),
   ).toBe(`a{background:url(/domino/www.example.org/domcfg.nsf/i.png)}`);
 });
+
+test('leaves form values alone so Domino redirects stay on its own host', () => {
+  const html = `<input name="RedirectTo" value="https://www.example.org/RCOA/x" type="hidden"><a href="https://www.example.org/RCOA/x">x</a>`;
+  expect(rewriteText(html, host, 'text/html')).toBe(
+    `<input name="RedirectTo" value="https://www.example.org/RCOA/x" type="hidden"><a href="/domino/www.example.org/RCOA/x">x</a>`,
+  );
+});
+
+test('rewrites protocol-relative references too', () => {
+  expect(
+    rewriteText(
+      `<base href="//www.example.org/RCOA/NELAUAT2.nsf/"><script src="//www.example.org/RCOA/NELAUAT2.nsf/a.js?openFileResource"></script>`,
+      host,
+      'text/html',
+    ),
+  ).toBe(
+    `<base href="/domino/www.example.org/RCOA/NELAUAT2.nsf/"><script src="/domino/www.example.org/RCOA/NELAUAT2.nsf/a.js?openFileResource"></script>`,
+  );
+});
