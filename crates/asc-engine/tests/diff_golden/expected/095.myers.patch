diff --git a/file b/file
index f6b04da..24b11af 100644
--- a/file
+++ b/file
@@ -10,13 +10,16 @@ publish = false
 workspace = true
 
 [features]
-default = ["serve", "vfs-projfs", "vfs-fuse", "git-compat", "git-ssh"]
+default = ["serve", "vfs-projfs", "vfs-fuse", "git-compat", "git-ssh", "http3"]
 # The git smart-HTTP layer (SPEC 25); forwards to `asc-git` and, when `serve` is on, `asc-serve`.
 git-compat = ["asc-git/git-compat", "asc-serve?/git-compat"]
 # SSH public keys in the token store and the SSH listener (SPEC 25.11); the SSH library lives in
 # `asc-serve` only, so this adds `asc serve ssh-key` and nothing to `asc-git`.
 git-ssh = ["git-compat", "asc-serve?/git-ssh"]
 serve = ["dep:asc-serve"]
+# HTTP/3 (U89b): the HTTPS client upgrades to h3 after `Alt-Svc`, and `asc serve` listens for QUIC
+# when `[tls]` and `http3_port` are set. Off, no QUIC crate is built.
+http3 = ["asc-rpc/http3", "asc-serve?/http3"]
 vfs-projfs = ["dep:asc-vfs", "asc-vfs/projfs"]
 vfs-fuse = ["dep:asc-vfs", "asc-vfs/fuse"]
 
@@ -57,6 +60,7 @@ tonic = { workspace = true }
 minisign-verify = { workspace = true }
 sha2 = { workspace = true }
 reqwest = { workspace = true }
+http = { workspace = true }
 object_store = { workspace = true }
 url = { workspace = true }
 zip = { workspace = true }
@@ -68,6 +72,9 @@ blake3 = { workspace = true }
 tempfile = { workspace = true }
 similar = { workspace = true }
 toml = { workspace = true }
+axum = { workspace = true }
+rustls = { workspace = true }
+rcgen = { version = "0.14.10", default-features = false, features = ["crypto", "ring", "pem"] }
 
 # vfs-projfs is Windows-only, vfs-fuse is Linux-only; the dep is optional on both.
 [target.'cfg(windows)'.dependencies]
