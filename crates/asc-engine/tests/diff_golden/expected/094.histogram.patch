+/**
+ * Refuse to run against front ends that are serving a compile error.
+ *
+ * WHY THIS EXISTS. A workspace package rebuilt while the front ends are
+ * compiling leaves them unable to resolve it, and `rsbuild` then serves an
+ * error overlay on every page. The overlay swallows clicks, so the run does
+ * not stop: it spends half an hour reporting a combobox that will not open,
+ * an invitation that never sends and a pile of accessibility violations
+ * measured against the overlay itself - none of which name the cause. Four
+ * runs have been lost to it.
+ *
+ * The build check before the servers start cannot catch this, because the
+ * rebuild happens AFTER it. Looking at what the servers actually serve can,
+ * and costs one page load each.
+ */
+async function refuseCompileOverlays(): Promise<void> {
+  const { chromium } = await import('@playwright/test');
+  const fronts = {
+    audits: URLS.audits,
+    adminUi: URLS.adminUi,
+    authUi: URLS.authUi,
+    schemaDesigner: URLS.schemaDesigner,
+    applicationList: URLS.applicationList,
+  };
+
+  const browser = await chromium.launch();
+  const serving: string[] = [];
+
+  try {
+    const page = await browser.newPage();
+    for (const [name, url] of Object.entries(fronts)) {
+      const reached = await page
+        .goto(url, { waitUntil: 'domcontentloaded', timeout: 20000 })
+        .then(() => true)
+        .catch(() => false);
+      if (!reached) continue;
+      const overlaid = await page
+        .locator('rsbuild-error-overlay')
+        .count()
+        .catch(() => 0);
+      if (overlaid > 0) serving.push(`${name} (${url})`);
+    }
+  } finally {
+    await browser.close();
+  }
+
+  if (serving.length > 0) {
+    throw new Error(
+      `${serving.length} front end(s) are serving a compile error overlay: ${serving.join(', ')}. Something rebuilt a workspace package while they were compiling - a build in another terminal, or another agent's session. Every click would land on the overlay rather than the page, so the run stops here instead of half an hour from now.`,
+    );
+  }
 }
 
 export default globalSetup;
