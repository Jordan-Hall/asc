diff --git a/file b/file
index 6894a9a..e5bd338 100644
--- a/file
+++ b/file
@@ -45,3 +45,30 @@ jobs:
       - run: sudo add-apt-repository -y ppa:git-core/ppa && sudo apt-get update -qq && sudo apt-get install -y -qq git
       - uses: Swatinem/rust-cache@d1527c8f67ef9af357290475d4af4b0fab8f12e0 # v2.9.3
       - run: bash build/ci/linux-check.sh
+
+  # asc-store's S3 suite against real Garage (no Docker); results in docs/garage-compat.md.
+  # The Garage binaries have no published checksums, so the hashes below are the ones recorded when first fetched.
+  garage-compat:
+    runs-on: ubuntu-latest
+    strategy:
+      fail-fast: false
+      matrix:
+        include:
+          - garage: v1.3.1
+            sha256: 0441419f7c0b372d37e533a80e08367023d30fa56a56d1db3f8a2aff27e24c92
+          - garage: v2.4.1
+            sha256: ae49f8de4aaee6b5ca305f7cbdccc8cd8a29b2804aac074649f18bfb83d0a2b6
+    steps:
+      - uses: actions/checkout@11d5960a326750d5838078e36cf38b85af677262 # v4.4.0
+      - uses: dtolnay/rust-toolchain@035fceb3c12fb0c6a9461b52775e16473133e591 # 1.95.0
+        with:
+          toolchain: 1.95.0
+      - uses: Swatinem/rust-cache@d1527c8f67ef9af357290475d4af4b0fab8f12e0 # v2.9.3
+      - name: Fetch Garage ${{ matrix.garage }}
+        run: |
+          mkdir -p "$HOME/garage-bin"
+          curl -fsSL -o "$HOME/garage-bin/garage" "https://garagehq.deuxfleurs.fr/_releases/${{ matrix.garage }}/x86_64-unknown-linux-musl/garage"
+          echo "${{ matrix.sha256 }}  $HOME/garage-bin/garage" | sha256sum -c -
+          chmod +x "$HOME/garage-bin/garage"
+      # Both versions ignore If-None-Match, so the probe must fail (BucketRefs refused); a change here is news.
+      - run: GARAGE_BIN="$HOME/garage-bin/garage" ASC_IT_GARAGE_EXPECT_EXCLUSIVE=false bash build/ci/garage-it.sh
