+
+test('a waiting save stands by the change it is for: saves go in the order the changes were made', () => {
+  const turns = new Turns();
+  // Ann is saving; Bob's change came before Cat's, though Cat asked first
+  turns.claim('ann', 1, 1);
+  turns.claim('cat', 2, 5);
+  turns.claim('bob', 3, 3);
+  expect(turns.state().queue).toEqual(['bob', 'cat']);
+  // A claim for no change the room saw stands after every one that has
+  turns.claim('dan', 4);
+  expect(turns.state().queue).toEqual(['bob', 'cat', 'dan']);
+  // The holder is never displaced, whatever its order
+  expect(turns.state().holder).toBe('ann');
+});
