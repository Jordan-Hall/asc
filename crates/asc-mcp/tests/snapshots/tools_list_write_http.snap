---
source: crates/asc-mcp/src/catalogue.rs
expression: tools_list_json(ctx)
---
{
  "tools": [
    {
      "annotations": {
        "destructiveHint": false,
        "idempotentHint": false,
        "openWorldHint": false,
        "readOnlyHint": false
      },
      "description": "Create a changeset from file operations. update_ref must be empty (a draft change) or refs/for/*; any other value is refused.",
      "inputSchema": {
        "$defs": {
          "FileOp": {
            "oneOf": [
              {
                "required": [
                  "put_content"
                ]
              },
              {
                "required": [
                  "put_file_id"
                ]
              },
              {
                "required": [
                  "delete"
                ]
              },
              {
                "required": [
                  "move_from"
                ]
              },
              {
                "not": {
                  "anyOf": [
                    {
                      "required": [
                        "put_content"
                      ]
                    },
                    {
                      "required": [
                        "put_file_id"
                      ]
                    },
                    {
                      "required": [
                        "delete"
                      ]
                    },
                    {
                      "required": [
                        "move_from"
                      ]
                    }
                  ]
                }
              }
            ],
            "properties": {
              "delete": {
                "type": "boolean"
              },
              "mode": {
                "minimum": 0,
                "type": "integer"
              },
              "move_from": {
                "anyOf": [
                  {
                    "type": "string"
                  },
                  {
                    "additionalProperties": false,
                    "properties": {
                      "b64": {
                        "type": "string"
                      }
                    },
                    "required": [
                      "b64"
                    ],
                    "type": "object"
                  }
                ]
              },
              "path": {
                "anyOf": [
                  {
                    "type": "string"
                  },
                  {
                    "additionalProperties": false,
                    "properties": {
                      "b64": {
                        "type": "string"
                      }
                    },
                    "required": [
                      "b64"
                    ],
                    "type": "object"
                  }
                ]
              },
              "put_content": {
                "anyOf": [
                  {
                    "type": "string"
                  },
                  {
                    "additionalProperties": false,
                    "properties": {
                      "b64": {
                        "type": "string"
                      }
                    },
                    "required": [
                      "b64"
                    ],
                    "type": "object"
                  }
                ]
              },
              "put_file_id": {
                "pattern": "^([0-9a-f]{2})+$",
                "type": "string"
              }
            },
            "type": "object"
          },
          "RefTarget": {
            "oneOf": [
              {
                "required": [
                  "changeset"
                ]
              },
              {
                "required": [
                  "tag"
                ]
              },
              {
                "not": {
                  "anyOf": [
                    {
                      "required": [
                        "changeset"
                      ]
                    },
                    {
                      "required": [
                        "tag"
                      ]
                    }
                  ]
                }
              }
            ],
            "properties": {
              "changeset": {
                "pattern": "^([0-9a-f]{2})+$",
                "type": "string"
              },
              "tag": {
                "pattern": "^([0-9a-f]{2})+$",
                "type": "string"
              }
            },
            "type": "object"
          }
        },
        "additionalProperties": false,
        "properties": {
          "expect": {
            "$ref": "#/$defs/RefTarget"
          },
          "message": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "additionalProperties": false,
                "properties": {
                  "b64": {
                    "type": "string"
                  }
                },
                "required": [
                  "b64"
                ],
                "type": "object"
              }
            ]
          },
          "ops": {
            "items": {
              "$ref": "#/$defs/FileOp"
            },
            "type": "array"
          },
          "parent": {
            "type": "string"
          },
          "repo": {
            "description": "Repository as owner/name.",
            "pattern": "^[^/]+/[^/]+$",
            "type": "string",
            "x-mcp-header": "Repo"
          },
          "update_ref": {
            "type": "string"
          }
        },
        "required": [
          "repo"
        ],
        "type": "object"
      },
      "name": "commit",
      "outputSchema": {
        "properties": {
          "git": {
            "pattern": "^([0-9a-f]{2})+$",
            "type": "string"
          },
          "id": {
            "pattern": "^([0-9a-f]{2})+$",
            "type": "string"
          }
        },
        "type": "object"
      }
    },
    {
      "annotations": {
        "destructiveHint": true,
        "idempotentHint": false,
        "openWorldHint": false,
        "readOnlyHint": false
      },
      "description": "Upload changes for review through the push pipeline. Always asks for confirmation.",
      "inputSchema": {
        "additionalProperties": false,
        "properties": {
          "changes": {
            "description": "Change ids to submit.",
            "items": {
              "type": "string"
            },
            "type": "array"
          },
          "draft": {
            "description": "Submit as drafts.",
            "type": "boolean"
          },
          "force": {
            "description": "Overwrite a diverged remote version.",
            "type": "boolean"
          },
          "repo": {
            "description": "Repository as owner/name.",
            "type": "string"
          },
          "reviewers": {
            "description": "Reviewer names.",
            "items": {
              "type": "string"
            },
            "type": "array"
          }
        },
        "required": [
          "repo",
          "changes"
        ],
        "type": "object"
      },
      "name": "submit",
      "outputSchema": {
        "properties": {
          "message": {
            "type": "string"
          },
          "results": {
            "items": {
              "type": "object"
            },
            "type": "array"
          },
          "rewritten": {
            "items": {
              "type": "object"
            },
            "type": "array"
          }
        },
        "type": "object"
      }
    },
    {
      "annotations": {
        "destructiveHint": false,
        "idempotentHint": false,
        "openWorldHint": false,
        "readOnlyHint": false
      },
      "description": "Rebase head onto onto and report conflicts. dry_run defaults to true; update_ref must be empty or refs/for/*.",
      "inputSchema": {
        "$defs": {
          "FileOp": {
            "oneOf": [
              {
                "required": [
                  "put_content"
                ]
              },
              {
                "required": [
                  "put_file_id"
                ]
              },
              {
                "required": [
                  "delete"
                ]
              },
              {
                "required": [
                  "move_from"
                ]
              },
              {
                "not": {
                  "anyOf": [
                    {
                      "required": [
                        "put_content"
                      ]
                    },
                    {
                      "required": [
                        "put_file_id"
                      ]
                    },
                    {
                      "required": [
                        "delete"
                      ]
                    },
                    {
                      "required": [
                        "move_from"
                      ]
                    }
                  ]
                }
              }
            ],
            "properties": {
              "delete": {
                "type": "boolean"
              },
              "mode": {
                "minimum": 0,
                "type": "integer"
              },
              "move_from": {
                "anyOf": [
                  {
                    "type": "string"
                  },
                  {
                    "additionalProperties": false,
                    "properties": {
                      "b64": {
                        "type": "string"
                      }
                    },
                    "required": [
                      "b64"
                    ],
                    "type": "object"
                  }
                ]
              },
              "path": {
                "anyOf": [
                  {
                    "type": "string"
                  },
                  {
                    "additionalProperties": false,
                    "properties": {
                      "b64": {
                        "type": "string"
                      }
                    },
                    "required": [
                      "b64"
                    ],
                    "type": "object"
                  }
                ]
              },
              "put_content": {
                "anyOf": [
                  {
                    "type": "string"
                  },
                  {
                    "additionalProperties": false,
                    "properties": {
                      "b64": {
                        "type": "string"
                      }
                    },
                    "required": [
                      "b64"
                    ],
                    "type": "object"
                  }
                ]
              },
              "put_file_id": {
                "pattern": "^([0-9a-f]{2})+$",
                "type": "string"
              }
            },
            "type": "object"
          },
          "RefTarget": {
            "oneOf": [
              {
                "required": [
                  "changeset"
                ]
              },
              {
                "required": [
                  "tag"
                ]
              },
              {
                "not": {
                  "anyOf": [
                    {
                      "required": [
                        "changeset"
                      ]
                    },
                    {
                      "required": [
                        "tag"
                      ]
                    }
                  ]
                }
              }
            ],
            "properties": {
              "changeset": {
                "pattern": "^([0-9a-f]{2})+$",
                "type": "string"
              },
              "tag": {
                "pattern": "^([0-9a-f]{2})+$",
                "type": "string"
              }
            },
            "type": "object"
          },
          "RepoRef": {
            "properties": {
              "id_mode": {
                "enum": [
                  "asc",
                  "git"
                ]
              },
              "name": {
                "type": "string"
              }
            },
            "type": "object"
          },
          "Resolution": {
            "properties": {
              "changeset": {
                "pattern": "^([0-9a-f]{2})+$",
                "type": "string"
              },
              "op": {
                "$ref": "#/$defs/FileOp"
              },
              "path": {
                "anyOf": [
                  {
                    "type": "string"
                  },
                  {
                    "additionalProperties": false,
                    "properties": {
                      "b64": {
                        "type": "string"
                      }
                    },
                    "required": [
                      "b64"
                    ],
                    "type": "object"
                  }
                ]
              }
            },
            "type": "object"
          }
        },
        "additionalProperties": false,
        "properties": {
          "base": {
            "type": "string"
          },
          "dry_run": {
            "default": true,
            "type": "boolean"
          },
          "expect": {
            "$ref": "#/$defs/RefTarget"
          },
          "head": {
            "type": "string"
          },
          "head_repo": {
            "$ref": "#/$defs/RepoRef"
          },
          "onto": {
            "type": "string"
          },
          "repo": {
            "description": "Repository as owner/name.",
            "pattern": "^[^/]+/[^/]+$",
            "type": "string",
            "x-mcp-header": "Repo"
          },
          "resolutions": {
            "items": {
              "$ref": "#/$defs/Resolution"
            },
            "type": "array"
          },
          "update_ref": {
            "type": "string"
          }
        },
        "required": [
          "repo"
        ],
        "type": "object"
      },
      "name": "rebase",
      "outputSchema": {
        "properties": {
          "conflicts": {
            "items": {
              "type": "object"
            },
            "type": "array"
          },
          "result": {
            "pattern": "^([0-9a-f]{2})+$",
            "type": "string"
          },
          "rewritten": {
            "items": {
              "type": "object"
            },
            "type": "array"
          }
        },
        "type": "object"
      }
    },
    {
      "annotations": {
        "destructiveHint": false,
        "idempotentHint": false,
        "openWorldHint": false,
        "readOnlyHint": false
      },
      "description": "Restack changes onto a new base. dry_run defaults to true.",
      "inputSchema": {
        "$defs": {
          "RefTarget": {
            "oneOf": [
              {
                "required": [
                  "changeset"
                ]
              },
              {
                "required": [
                  "tag"
                ]
              },
              {
                "not": {
                  "anyOf": [
                    {
                      "required": [
                        "changeset"
                      ]
                    },
                    {
                      "required": [
                        "tag"
                      ]
                    }
                  ]
                }
              }
            ],
            "properties": {
              "changeset": {
                "pattern": "^([0-9a-f]{2})+$",
                "type": "string"
              },
              "tag": {
                "pattern": "^([0-9a-f]{2})+$",
                "type": "string"
              }
            },
            "type": "object"
          },
          "RestackItem": {
            "properties": {
              "change": {
                "pattern": "^([k-z]{2})+$",
                "type": "string"
              },
              "expect": {
                "$ref": "#/$defs/RefTarget"
              },
              "update_ref": {
                "type": "string"
              }
            },
            "type": "object"
          }
        },
        "additionalProperties": false,
        "properties": {
          "atomic": {
            "type": "boolean"
          },
          "dry_run": {
            "default": true,
            "type": "boolean"
          },
          "items": {
            "items": {
              "$ref": "#/$defs/RestackItem"
            },
            "type": "array"
          },
          "onto": {
            "type": "string"
          },
          "repo": {
            "description": "Repository as owner/name.",
            "pattern": "^[^/]+/[^/]+$",
            "type": "string",
            "x-mcp-header": "Repo"
          }
        },
        "required": [
          "repo"
        ],
        "type": "object"
      },
      "name": "restack",
      "outputSchema": {
        "properties": {
          "conflicts": {
            "items": {
              "type": "object"
            },
            "type": "array"
          },
          "patch_unchanged": {
            "items": {
              "pattern": "^([k-z]{2})+$",
              "type": "string"
            },
            "type": "array"
          },
          "rewritten": {
            "items": {
              "type": "object"
            },
            "type": "array"
          }
        },
        "type": "object"
      }
    },
    {
      "annotations": {
        "destructiveHint": true,
        "idempotentHint": false,
        "openWorldHint": true,
        "readOnlyHint": false
      },
      "description": "Land a stack on a branch through the server's land pipeline: protections, required approvals, path rules and hooks apply. dry_run defaults to true and previews conflicts; always asks for confirmation. Conflicts come back as data.",
      "inputSchema": {
        "additionalProperties": false,
        "properties": {
          "branch": {
            "description": "Branch to land on; it must be one the repository accepts land requests on.",
            "type": "string"
          },
          "changes": {
            "description": "Change ids of one stack; the last is the tip. Give changes or tip.",
            "items": {
              "type": "string"
            },
            "maxItems": 100,
            "type": "array"
          },
          "dry_run": {
            "default": true,
            "description": "Preview only (default true). Send false to land.",
            "type": "boolean"
          },
          "repo": {
            "description": "Repository as owner/name.",
            "type": "string"
          },
          "tip": {
            "description": "Revision of the stack tip. Give changes or tip.",
            "type": "string"
          }
        },
        "required": [
          "repo",
          "branch"
        ],
        "type": "object"
      },
      "name": "land",
      "outputSchema": {
        "properties": {
          "changed_protected": {
            "description": "Protected paths the stack changes (preview).",
            "items": {
              "type": "string"
            },
            "type": "array"
          },
          "conflicts": {
            "description": "Paths that conflict (preview).",
            "items": {
              "type": "string"
            },
            "type": "array"
          },
          "dry_run": {
            "description": "Whether this was a preview.",
            "type": "boolean"
          },
          "message": {
            "type": "string"
          },
          "results": {
            "items": {
              "type": "object"
            },
            "type": "array"
          },
          "rewritten": {
            "items": {
              "type": "object"
            },
            "type": "array"
          },
          "would_land": {
            "description": "Whether the stack merges without conflicts.",
            "type": "boolean"
          }
        },
        "type": "object"
      }
    }
  ]
}
